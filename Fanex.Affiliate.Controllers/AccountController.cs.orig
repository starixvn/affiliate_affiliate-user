        #region Daily Earnings KIOSK

        /// <summary>
        /// Daily Earning Kiosk.
        /// </summary>
        /// <returns>Return view.</returns>
        [HttpGet]
        public ActionResult DailyEarningsKiosk()
        {
            var targetDate = DateTime.Now.Date;
            var startDate = targetDate.AddMonths(-1);
            var criteria = new DailyEarningCriteria
            {
                AffId = CurrentSession.AffId,
                ProductId = 0,
                FromDate = startDate,
                ToDate = targetDate,
            };

            return DailyEarningsKiosk(criteria);
        }

        /// <summary>
        /// Daily Earning Kiosk.
        /// </summary>
        /// <param name="criteria">Daily earning criteria.</param>
        /// <returns>Return view.</returns>
        [HttpPost]
        public ActionResult DailyEarningsKiosk(DailyEarningCriteria criteria)
        {
            var productCriteria = new ProductCriteria
            {
                Language = AppSession.Language,
                AffId = CurrentSession.AffId,
                MonthDate = criteria.MonthDate
            };

            var model = new DailyEarningsKioskViewModel();
            string affCurrency;

            criteria.AffId = CurrentSession.AffId;
            if (criteria.FromDate != null)
            {
                model.FromDate = (DateTime)criteria.FromDate;
            }

            if (criteria.ToDate != null)
            {
                model.ToDate = (DateTime)criteria.ToDate;
            }

            model.ListProduct = _productService.GetProductList(productCriteria).ToList();
            model.ProductId = criteria.ProductId;
            model.ListDailyEarning = _accountService.GetDailyEarnings(criteria, out affCurrency).ToList();
            FormaterCurrency.SetDefaultCurrency(affCurrency);

            return View(model);
        }

        /// <summary>
        /// Daily Earning Detail Kiosk.
