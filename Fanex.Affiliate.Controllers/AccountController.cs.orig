        #region Statement History

        /// <summary>
        /// Action get statement history.
        /// </summary>
        /// <param name="pageSize">Input page size.</param>
        /// <param name="page">Input page index.</param>
        /// <returns>Return view.</returns>
        [HttpGet]
        public ActionResult Statement([Optional, DefaultParameterValue(0)] int pageSize, [Optional, DefaultParameterValue(1)] int page)
        {
            var itemPerPage = pageSize > 0 ? pageSize : AppSettings.PageSize;
            int currentPageIndex = page;
            int totalPage = 0;
            var criterias = new StatementCriteria
            {
                AffId = CurrentSession.AffId,
                PageIndex = currentPageIndex,
                PageSize = itemPerPage,
                TotalPages = totalPage
            };

            if (criterias.IsValid)
            {
                var statement = _accountService.GetStatementHistory(criterias, ref totalPage);
                return View(statement.ToPagedList(currentPageIndex, itemPerPage, totalPage * itemPerPage));
            }

            return View();
        }

        #endregion Statement History

        #region Daily Earnings

        /// <summary>
        /// Action open popup Daily Earning.
        /// </summary>
        /// <param name="criteria">Daily earning criteria.</param>
        /// <returns>Return view.</returns>
        [HttpGet]
        public ActionResult DailyEarning(DailyEarningCriteria criteria)
        {
            var productCriteria = new ProductCriteria
                {
                    Language = AppSession.Language,
                    AffId = CurrentSession.AffId,
                    MonthDate = criteria.MonthDate
                };

            var model = new DailyEarningViewModel();
            string affCurrency;

            criteria.AffId = CurrentSession.AffId;
            model.ProductId = criteria.ProductId;
            model.ListProduct = productCriteria.IsValid() ? _productService.GetProductList(productCriteria).ToList() : null;
            model.ListDailyEarning = criteria.IsValid() ? _accountService.GetDailyEarnings(criteria, out affCurrency).ToList() : null;
            FormaterCurrency.SetDefaultCurrency(affCurrency);

            return View(model);
        }

