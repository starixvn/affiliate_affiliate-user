@helper DropDownListGetYear(int start, int selectedValue, IDictionary<string, object> htmlAttributies = null)
    {
        var name = "class=\"sel-filter\" ";
        if (htmlAttributies != null)
        {
            name += htmlAttributies.ContainsKey("id") ? "id=\"" + htmlAttributies["id"] + "\" name=\"" + htmlAttributies["id"] + "\"" : string.Empty;
        }
    <select @( new HtmlString(name))>
        @for (var i = start; i <= DateTime.Now.Year; i++)
        {
            <option value="@i"  @(i == selectedValue ? "selected=\"selected\"" : string.Empty)>@i</option>
        }
    </select>
}

@helper DropDownListProduct(List<Product> list, string selectedValue, IDictionary<string, object> htmlAttributies = null)
    {
        var name = string.Empty;
        var style = string.Empty;
        if (htmlAttributies != null)
        {
            name = htmlAttributies.ContainsKey("id") ? "id=\"" + htmlAttributies["id"] + "\" name=\"" + htmlAttributies["id"] + "\"" : string.Empty;
            style = htmlAttributies.ContainsKey("style") ? "style=\"" + htmlAttributies["style"] + "\"" : string.Empty;
        }
    <select @( new HtmlString(name)) @(new HtmlString(style))>
        @foreach (var item in list)
        {

            <option value="@item.ProductName" data-total-members="@item.TotalQualifiedMembers"  @(item.ProductName == selectedValue ? "selected=\"selected\"" : string.Empty)>@item.ProductName</option>
        }
    </select>
}

@helper DropDownListProduct(List<Product> list, int selectedValue, IDictionary<string, object> htmlAttributies = null)
    {
        var name = string.Empty;
        var style = string.Empty;
        if (htmlAttributies != null)
        {
            name = htmlAttributies.ContainsKey("id") ? "id=\"" + htmlAttributies["id"] + "\" name=\"" + htmlAttributies["id"] + "\"" : string.Empty;
            style = htmlAttributies.ContainsKey("style") ? "style=\"" + htmlAttributies["style"] + "\"" : string.Empty;
        }
    <select @( new HtmlString(name)) @(new HtmlString(style))>
        @if (list.Count > 1)
        {
            <option value="0" @(selectedValue == 0 ? "selected=\"selected\"" : string.Empty)>@Lang.All</option>
        }
        @foreach (var item in list)
        {
            <option value="@item.ProductId" @(item.ProductId == selectedValue ? "selected=\"selected\"" : string.Empty)>@item.ProductName</option>
        }
    </select>
}

