@helper DropDownListGetMonth(int selectedValue, IDictionary<string, object> htmlAttributies = null)
    {
        var name = "class=\"sel-filter\" ";
        if (htmlAttributies != null)
        {
            name += htmlAttributies.ContainsKey("id") ? "id=\"" + htmlAttributies["id"] + "\" name=\"" + htmlAttributies["id"] + "\"" : string.Empty;
        }
    <select @( new HtmlString(name))>
        <option value="1"  @(1 == selectedValue ? "selected=\"selected\"" : string.Empty)>@Lang.January</option>
        <option value="2"  @(2 == selectedValue ? "selected=\"selected\"" : string.Empty)>@Lang.February</option>
        <option value="3"  @(3 == selectedValue ? "selected=\"selected\"" : string.Empty)>@Lang.March</option>
        <option value="4"  @(4 == selectedValue ? "selected=\"selected\"" : string.Empty)>@Lang.April</option>
        <option value="5"  @(5 == selectedValue ? "selected=\"selected\"" : string.Empty)>@Lang.May</option>
        <option value="6"  @(6 == selectedValue ? "selected=\"selected\"" : string.Empty)>@Lang.June</option>
        <option value="7"  @(7 == selectedValue ? "selected=\"selected\"" : string.Empty)>@Lang.July</option>
        <option value="8"  @(8 == selectedValue ? "selected=\"selected\"" : string.Empty)>@Lang.August</option>
        <option value="9"  @(9 == selectedValue ? "selected=\"selected\"" : string.Empty)>@Lang.September</option>
        <option value="10"  @(10 == selectedValue ? "selected=\"selected\"" : string.Empty)>@Lang.October</option>
        <option value="11"  @(11 == selectedValue ? "selected=\"selected\"" : string.Empty)>@Lang.November</option>
        <option value="12"  @(12 == selectedValue ? "selected=\"selected\"" : string.Empty)>@Lang.December</option>
    </select>
}

@helper GetMonthName(int month)
    {
    switch (month)
