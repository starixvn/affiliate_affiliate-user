@helper GenerateLink(string linkFormat, int customerID, string domain, string link, string languageId)
    {
        string gnLink = linkFormat.Replace("{custid}", customerID.ToString());
        gnLink = gnLink.Replace("{domain}", domain);
        gnLink = gnLink.Replace("{target}", link);
        gnLink = string.IsNullOrEmpty(languageId) ? gnLink.Replace("/{lang}", string.Empty) : gnLink.Replace("{lang}", languageId);
        @gnLink;
    }
@helper GetMoreUrls(string moreSiteUrls)
    {
        if (!string.IsNullOrEmpty(moreSiteUrls))
        {
            var lastIndex = moreSiteUrls.Length - 1;

            moreSiteUrls = (moreSiteUrls.LastIndexOf(';') == lastIndex) ? moreSiteUrls.Remove(lastIndex) : moreSiteUrls;

            var sites = moreSiteUrls.Split(';');

            for (int index = 0; index < sites.Count(); index++)
            {
                <tr id="site_@(index + 2)">
                    <td>@(Lang.SiteURL + " " + (index + 2).ToString())</td>
                    <td></td>
                    <td><input type="text" class="sites more-site" id="more_@(index + 2)" value="@sites[index]" /></td>
                    <td><input type="button" value="@Lang.Delete" class="button" onclick="SIGNUP.delUrl(this);"/></td>
                </tr>
            }
        }        
}
