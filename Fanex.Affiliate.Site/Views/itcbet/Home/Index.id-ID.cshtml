@{
    ViewBag.Title = Lang.ProgramDetails;
    Layout = @String.Format("../Layout/Layout{0}/_Layout.cshtml", AppSettings.Layout);
}
@model DefaultProductCommissionViewModel
@{
    string productList = string.Empty;

    if (Model.ProductList.Count > 0)
    {
        foreach (var product in Model.ProductList)
        {
            productList += ProductsFormatter.Format(product.ProductName) + ", ";
        }

        productList = productList.Substring(0, productList.Length - 2);
    }
}

@{
    var classThai = AppSession.Language.Equals("th-TH") ? AppSession.Language : string.Empty;
    var classType = string.Format("class='span12 box-insite {0}'", classThai);
}

<div @Html.Raw(classType)>
    <div class="top">
        <div class="in-top">@Lang.ProgramDetails</div>
        <div class="in-right">
        </div>
    </div>
    <div class="content">
        <div class="block">
            <div class="content-block">
                <p>@Html.Raw(string.Format("Sebagai Afiliasi {0}, Anda akan memperoleh komisi atas setiap pemain yang Anda rujukkan ke {0} selama masa berlaku rekening pemain itu. Sistem pelaporan online kami akan tersedia selama 24 jam sehari, 7 hari seminggu untuk Anda gunakan.", AppSettings.SystemDisplayName))</p>
                <p>Perolehan Anda akan bergantung pada jumlah trafik yang dapat Anda kirim melalui situs web Anda. Tugas kami adalah memandu mereka menjalani proses pendaftaran, meminta mereka untuk membayarkan setoran pertama, dan menjaga bisnis mereka dengan berbagai bonus dan penawaran kami yang menarik. </p>
            </div>
        </div>
        @if (!AppSettings.IsKiosk)
        {
            <div class="block">
                <div class="title-block">
                    Dukungan Mata Uang Dasar Afiliasi <a href="#" class="link-top"><span></span>@Lang.Top</a>
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <p>Kami menawarkan mata uang dasar berikut: @AppSettings.AffiliateBaseCurrencyExcludedUUSList.</p>
                    @{
                        var baseCurrencyList = AppSettings.AffiliateBaseCurrencyExcludedUUSList;
                        var multiplyByCurrencyList = AppSettings.AffiliateCurrencyListMultipliedBy.Split(',');
                        var commonCurrencyList = baseCurrencyList.Intersect(multiplyByCurrencyList);

                        if (commonCurrencyList.Any())
                        {
                            <p>@string.Format("Dalam laporan-2 dan pengaturan komisi kami, kami akan menghilangkan beberapa angka nol terakhir dari mata uang berikut: {0} Sebagai contoh: {1} 1 adalah {1} 1* {2} dalam nilai asli.", AppSettings.AffiliateCurrencyListMultipliedBy, FormaterCurrency.GetCurrencySymbol(commonCurrencyList.First()), AppSettings.MulitpliedBy)</p>
                        }
                    }
                </div>
            </div>
            <div class="block">
                <div class="title-block">
                    Apakah Program Afiliasi itu? <a href="#" class="link-top"><span></span>@Lang.Top</a>
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <p>
                        <b>Model pembagian hasil dibagi menjadi 2 komponen. Pembagian hasil dari Casino dan pembagian hasil dari Permainan olahraga, perhitungan dijelaskan dengan dibawah ini.  Total pembagian keuntungan yang dibayarkan kepada affiliasi merupakan jumlah dari kedua komponen  model keuntungan.</b>
                        <br />
                        Model pembagian pendapatan dipisahkan menjadi komponen-2 berikut: @productList.
                    </p>
                    <p>Jumlah total bagian pendapatan yang akan dibayarkan kepada afiliasi merupakan jumlah dari seluruh komponen dari model pembagian pendapatan. Berikut ini adalah contoh model pembagian pendapatan dari sistem kami:</p>
                    <table class="table odd-even list">
                        <thead>
                            <tr>
                                <th style="width: 85px; text-align: center;">
                                    @Lang.Product
                                </th>
                                <th style="width: 10px; text-align: center;">
                                    @Lang.Tier
                                </th>
                                <th style="text-align: center;">
                                    @string.Format(Lang.ComNetWin, AppSettings.DefaultCurrencySymbol)
                                </th>
                                <th style="width: 150px; text-align: center;">
                                    @Lang.QualifyingMembers
                                </th>
                                <th style="width: 50px; text-align: center;">
                                    @Lang.Commission
                                </th>
                            </tr>
                        </thead>
                        @if (Model.ProductList.Any())
                        {
                            <tbody>
                                @{
                            const int MAXQM = 1000000000;
                            const long MAXAMOUNT = 100000000000000;
                            var oldProductId = 0;
                            var index = 0;
                            foreach (var product in Model.ProductList)
                            {
                                var listGroupSetting = Model.GroupSetting.Where(p => (AppSettings.IsShowZeroCommission == "1") ? p.ProductId == product.ProductId : p.ProductId == product.ProductId && p.Commission != 0).ToList();
                                int totalShownTier = listGroupSetting.Count;
                                var noTier = 0;
                                if (totalShownTier > 0)
                                {
                                    index++;
                                    foreach (var groupSetting in listGroupSetting)
                                    {

                                            <tr class="@(index % 2 == 0 ? "even" : "odd")">
                                                @if (oldProductId != groupSetting.ProductId)
                                                {
                                                    <td rowspan="@totalShownTier" class="bold text-center">
                                                        @ProductsFormatter.Format(product.ProductName)
                                                    </td>
                                                }
                                                <td class="text-center">
                                                    @(++noTier)
                                                </td>
                                                <td class="text-right">
                                                    @string.Format("{0}{1}", FormaterCurrency.Format(groupSetting.MinAmount),
                                                    groupSetting.MaxAmount == MAXAMOUNT ? "+" : " - " + FormaterCurrency.Format(Convert.ToInt64(groupSetting.MaxAmount) + 0.99))
                                                </td>
                                                <td class="text-right">
                                                    @string.Format("{0}{1}", groupSetting.MinQM,
                                                    groupSetting.MaxQM == MAXQM ? "+" : " - " + groupSetting.MaxQM.ToString())
                                                </td>
                                                <td class="text-right">
                                                    @string.Format("{0}%", Convert.ToDouble(groupSetting.Commission) * 100)
                                                </td>
                                            </tr>
                                                oldProductId = product.ProductId;
                                    }
                                }
                            }
                                }
                            </tbody>
                        }
                        else
                        {
                            <tfoot>
                                <tr>
                                    <td colspan="5" align="center">@Lang.NoInformation
                                    </td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                    <p>
                        Untuk tujuan tabel di atas:
                        <br />
                        "KEUNTUNGAN BERSIH PERUSAHAAN BULAN INI" =|-Pendapatan(Menang atau Kalah) - Setiap bonus yang dipayarkan - Pengembalian - Setiap penghasilan lain - Kredit, kompensasi atau pengembalian yang diberikan pada Pemain|
                        @if (AppSettings.CompanyNegativeNetWin > 0)
                        {
                            <p>@string.Format("Jika Keuntungan Bersih Perusahaan adalah negatif, maka Affiliasi harus menanggung {0}% dari kekalahan perusahaan tersebut (diterapkan per produk, bukan total keseluruhan)", AppSettings.CompanyNegativeNetWin)</p>
                        }
                    </p>
                    <span></span>
                </div>
            </div>
            <div class="block">
                <div class="title-block">Negatif Saldo<a href="#" class="link-top"><span></span>@Lang.Top</a>
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <p>@Html.Raw(string.Format("Semua negatif saldo untuk bulan tertentu akan dipindahkan pada bulan selanjutnya. Sebagai contoh, jika pada bulan Januari, akun afiliasi anda berakhir dengan -{0}2,555, jumlah ini akan dipindahkan ke bulan Februari. Jika pada akhir Februari, akun afiliasi anda menghasilkan {0}3,400, total saldo akan menjadi {0}845 ({0}3,400-{0}2,555). Namun jika akun anda masih rugi pada bulan Februari, sebagai contoh -{0}1,600, maka jumlah tersebut akan ditambahkan ke negatif saldo sebelumnya dan dipindahkan pada bulan Maret, sehingga saldo anda pada bulan Maret menjadi -{0}4,155. Komisi yang didapatkan akan dibayar sesuai dengan tingkatannya.", AppSettings.DefaultCurrencySymbol))</p>
                    <p>Catat bahwa contoh di atas digunakan untuk mata uang @AppSettings.DefaultCurrency</p>
                </div>
            </div>
            <div class="block">
                <div class="title-block">
                    Pemberian Bayaran <a href="#" class="link-top"><span></span>@Lang.Top</a>
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <p>@string.Format("Anda dapat meminta pembayaran dalam mata uang {0}. Pada tanggal pembayaran akan digunakan masing-2 kurs jual beli yang berlaku.", string.Join(", ", AppSettings.PlayerCurrenciesExcludedUUS))</p>
                    <p>@string.Format("Kami menawarkan metode penarikan hanya melalui akun pemain {0} Anda. Jumlah minimum dari permintaan penarikan tergantung pada setiap mata uang dasar afiliasi.", AppSettings.SystemDisplayName)</p>
                </div>
            </div>
        }
    </div>
</div>
