@{
    ViewBag.Title = Lang.MessageHistory;
    Layout = @String.Format("../Layout/Layout{0}/_Layout.cshtml", AppSettings.Layout);
}

@model MessageViewModel

@{
    var today = DateTime.Now.Date;
} 

@section css
{
    @Styles.Render("~/css/datetimepicker")
}

@using (Html.BeginForm())
{
    <div class="span12 box-insite">
        <div class="top">
            <div class="in-top">
                @Lang.MessageHistory
            </div>
            <div class="in-right">
            </div>
        </div>
        <div class="content">
            @Html.ValidationSummary()
            <div class="block">
                <div class="content-block">
                    <div class="box-header">
                        <div class="row">
                            <div class="cell">
                                <div class="label">@Lang.Search:</div>
                                <div class="editor">@Html.DropDownList("SearchOption", Model.SearchOptionList, new {style = "width: 100%;"})</div>
                            </div>
                            <div class="cell">
                                <input type="checkbox" id="IsCheckDate" name="IsCheckDate" @(Model.FromDate.HasValue && Model.ToDate.HasValue ? "checked='checked'" : string.Empty) style="float: left; margin-right: 10px;"/>
                                <div class="label">@Lang.From:</div>
                                <div class="editor">
                                    @(Model.FromDate.HasValue ? Html.TextBox("FromDate", Common.ConvertDateTime(Model.FromDate, "/", true, false), new {@class = "datepicker"}) : Html.TextBox("FromDate", Common.ConvertDateTime(today, "/", true, false), new {@class = "datepicker", disabled = "disabled"}))
                                    <div class="icon-calendar" >
                                    </div>
                                </div>
                            </div>
                            <div class="cell">
                                <div class="label">@Lang.ToDate:</div>
                                <div class="editor">
                                    @(Model.ToDate.HasValue ? Html.TextBox("ToDate", Common.ConvertDateTime(Model.ToDate, "/", true, false), new {@class = "datepicker"}) : Html.TextBox("ToDate", Common.ConvertDateTime(today, "/", true, false), new {@class = "datepicker", disabled = "disabled"}))
                                    <div class="icon-calendar">
                                    </div>
                                </div>
                            </div>
                            <div class="cell">
                                <div class="editor">
                                    <input id="submit2" type="submit" value="@Lang.Submit" class="button"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content">
            @if (Model.MessageList.Any())
            {
                <div class="block">
                    <div class="content-block no-padding">
                        <div class="pagesize pull-right">
                            <span class="items-per-page">@Lang.PageSize
                                @Html.DropDownList("PageSize", new List<SelectListItem>
                                    {
                                        new SelectListItem {Value = "10", Text = "10", Selected = "10" == Model.MessageList.PageSize.ToString()},
                                        new SelectListItem {Value = "20", Text = "20", Selected = "20" == Model.MessageList.PageSize.ToString()},
                                        new SelectListItem {Value = "50", Text = "50", Selected = "50" == Model.MessageList.PageSize.ToString()},
                                        new SelectListItem {Value = "100", Text = "100", Selected = "100" == Model.MessageList.PageSize.ToString()},
                                        new SelectListItem {Value = "200", Text = "200", Selected = "200" == Model.MessageList.PageSize.ToString()}
                                    }, new { id = string.Empty, @class = "items-per-page" })</span>
                        </div>
                        <div class="paging-info clear">
                            @Html.Pager(Model.MessageList.PageSize, Model.MessageList.PageNumber, Model.MessageList.TotalItemCount)
                        </div>
                    </div>
                </div>
            }
            <div class="block">
                <div class="content-block no-padding">
                    <table class="table odd-even list no-margin">
                        <thead>
                            <tr class="gradient-header">
                                <th style="width: 15px;">
                                    &nbsp;
                                </th>
                                <th style="width: 30px;">
                                    @Lang.IDKey
                                </th>
                                <th style="width: 125px;" class="text-center">
                                    @Lang.PostDate
                                </th>
                                <th>
                                    @Lang.Message
                                </th>
                            </tr>
                        </thead>
                        @if (Model.MessageList.Any())
                        {
                            <tbody>
                            @{
                            int count = 1;
                            foreach (var item in Model.MessageList)
                            {
                                    <tr class="@(count % 2 == 0 ? "even" : "odd")">
                                        <td>
                                            @count.ToString()
                                        </td>
                                        <td class="text-right">
                                            @item.MessageId
                                        </td>
                                        <td class="text-center">
                                            @Common.ConvertDateTime(item.PostedDate, "/", true, true)
                                        </td>
                                        <td @(item.Important ? "class=important" : string.Empty)>
                                            @Html.Raw(item.Content)
                                        </td>
                                    </tr>
                                
                                count++;
                            }
                            }
                            </tbody>
                        }
                        else
                        {
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-center">@Lang.NoInformation</td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
            
            @if (Model.MessageList.Any())
            {
                <div class="block">
                    <div class="content-block no-padding">
                        <div class="paging-info clear">
                            @Html.Pager(Model.MessageList.PageSize, Model.MessageList.PageNumber, Model.MessageList.TotalItemCount)
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}    
@section scriptspage
{
    @Scripts.Render("~/js/message")
}
