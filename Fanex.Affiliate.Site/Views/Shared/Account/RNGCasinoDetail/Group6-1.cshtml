@{
    Layout = null;
    // Game type: ChineseZodiac; 
}
<link href="@Url.Content("/Content/betlist/rng-casino-hand-history.css")" rel="stylesheet" type="text/css" />
@model BetListResultsRNGCasinoDetailViewModel
@{
    var headerItem = Model.CasinoDetailHeaderList.FirstOrDefault();
    var hitItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Result_HitBetLine" || x.ShowType.Trim() == "Result_HitScatter");    
}
<table style="width: 100%;" class="casino-detail-table" cellpadding="0" cellspacing="0">
    <tr class="detail-header-row">
        <td class="game-type-text" colspan="6">@Model.Param.GameTypeName - @headerItem.BetTime
        </td>
    </tr>
    <tr class="player-total-row">
        <td colspan="6">
            @RNGCasino.Player: @headerItem.UserName - @RNGCasino.Viewin @Model.Param.CurrencyName
        </td>
    </tr>
    <tr class="detail-header-row">
        <td colspan="6">@headerItem.ResultName
        </td>
    </tr>
    <tr>
        <td colspan="6">
            @if (!string.IsNullOrEmpty(headerItem.Result))
            {
                @Html.Raw(headerItem.Result.Replace("/Form", Url.Content("~/") + "Form"))
            }
        </td>
    </tr>
    <tr>
        <td>@RNGCasino.PlayerHistoryNo
        </td>
        <td class="align-left" colspan="5">@Model.Param.PlayerHistoryNo
        </td>
    </tr>
    @if (!string.IsNullOrEmpty(headerItem.ModeResult))
    {
        <tr>
            <td>@RNGCasino.Mode
            </td>
            <td class="align-left" colspan="5">
                @headerItem.ModeResult
            </td>
        </tr>
    }
    @if (!string.IsNullOrEmpty(headerItem.AutoSpinResult))
    {
        <tr>
            <td>@RNGCasino.AutoSpin
            </td>
            <td class="align-left" colspan="5">
                @headerItem.AutoSpinResult
            </td>
        </tr>
    }
    @if (!string.IsNullOrEmpty(headerItem.FreeSpinResult))
    {
        <tr>
            <td>@RNGCasino.FreeSpin
            </td>
            <td class="align-left" colspan="5">
                @headerItem.FreeSpinResult
            </td>
        </tr>
    }
    @if (hitItem.Count() > 0)
    {
        <tr class="player-total-row">
            <td colspan="6">
                @RNGCasino.Normal @RNGCasino.Name
            </td>
        </tr>
        <tr class="detail-header-row">
            <td>@RNGCasino.TotalLineBet
            </td>
            <td>@RNGCasino.Symbol
            </td>
            <td>@RNGCasino.CoinSize
            </td>
            <td>@RNGCasino.BetPerLine
            </td>
            <td>@RNGCasino.Odds
            </td>
            <td>@RNGCasino.Win/@RNGCasino.Loss
            </td>
        </tr>
        foreach (var item in hitItem)
        {
        <tr>
            <td>@item.TotalLineBet
            </td>
            <td>
                @Html.Raw(item.Symbol.Replace("/img", Url.Content("~/") + "img"))
            </td>
            <td class="align-right">@FormaterCurrency.Format(item.CoinSizeBaseCurrencyValue)
            </td>
            <td class="align-right">@item.BetPerLine
            </td>
            <td class="align-right">@item.Odds
            </td>
            <td class="align-right">@Html.Raw(FormaterCurrency.Format(decimal.Parse(item.Win)))
            </td>
        </tr>             
        }
        var subItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Result_SubWin").FirstOrDefault();
        if (subItem != null)
        {
        <tr>
            <td>@subItem.ActionName
            </td>
            <td colspan="5" class="align-right">@Html.Raw(FormaterCurrency.Format(decimal.Parse(subItem.Win)))
            </td>
        </tr>
        }
    }
    <tr class="player-total-row">
        <td class="align-left">@RNGCasino.Bet
        </td>
        <td colspan="5" class="align-right">@FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.Bet))
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@RNGCasino.Win/@RNGCasino.Loss
        </td>
        <td colspan="5" class="align-right">@Html.Raw(FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.WinLoss)))
        </td>
    </tr>
</table>
