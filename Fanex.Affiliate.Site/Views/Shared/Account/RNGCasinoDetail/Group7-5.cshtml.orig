@model BetListResultsRNGCasinoDetailViewModel
@{
    var headerItem = Model.CasinoDetailHeaderList.FirstOrDefault();
}
<table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
    <tr class="detail-header-row">
        <td class="game-type-text" colspan="3">@Model.Param.GameTypeName - @headerItem.BetTime
        </td>
    </tr>
    <tr class="player-total-row">
        <td colspan="3">
            @RNGCasino.Player: @headerItem.UserName - @RNGCasino.Viewin @Model.Param.CurrencyName
        </td>
    </tr>
    <tr class="detail-header-row">
        <td colspan="3">
            @headerItem.ResultName
        </td>
    </tr>
    <tr>
        <td colspan="3">
            <table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
                @{
                    var results = headerItem.Result.Split(',');
                    if (!string.IsNullOrEmpty(headerItem.Result) && results.Length == 20)
                    {
                        <tr>
                            @for (int i = 0; i < 10; i++)
                            {
                                <td>@results[i]
                                </td>
                            }
                        </tr>
                        <tr>
                            @for (int i = 10; i < 20; i++)
                            {
                                <td>@results[i]
                                </td>
                            }
                        </tr>
                    }
                }
            </table>
        </td>
    </tr>
    <tr>
        <td>@RNGCasino.PlayerHistoryNo
        </td>
        <td colspan="2" class="align-left">@Model.Param.PlayerHistoryNo
        </td>
    </tr>
    <tr>
        <td>@RNGCasino.AutoPlay
        </td>
        <td colspan="2" class="align-left">@headerItem.AutoPlayResult
        </td>
    </tr>
    <tr class="detail-header-row">
        <td>
        </td>
        <td>@RNGCasino.Characters or @RNGCasino.Number
        </td>
        <td>
            #
        </td>
    </tr>
    <tr>
        <td>@RNGCasino.Pick
        </td>
        <td>@headerItem.PickNo
        </td>
        <td>@headerItem.PickCount
        </td>
    </tr>
    <tr>
        <td>@RNGCasino.Hit
        </td>
        <td>@headerItem.HitNo
        </td>
        <td>@headerItem.HitCount
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@RNGCasino.Bet
        </td>
        <td colspan="2" class="align-right">@FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.Bet))
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@RNGCasino.Odds
        </td>
        <td colspan="2" class="align-right">@FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.Odds))
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@RNGCasino.Win/@RNGCasino.Loss
        </td>
        <td colspan="2" class="align-right">@Html.Raw(FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.WinLoss)))
        </td>
    </tr>
</table>
