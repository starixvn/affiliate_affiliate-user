@{
    Layout = null;
    // Game type: Champions, Water Margin
}
<link href="@Url.Content("/Athena006User/Content/betlist/rng-casino-hand-history.css")" rel="stylesheet" type="text/css" />
@model BetListResultsRNGCasinoDetailViewModel
@{
    var headerItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "BasicInfo").FirstOrDefault();
    var hitItemList = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Result_HitBetLine");
    var hitBonusItemList = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Result_HitBonus");
    var totalItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Add_TotalLineWin").FirstOrDefault();
}
<table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
    <tr class="detail-header-row">
        <td class="game-type-text" colspan="6">@Model.Param.GameTypeName - @headerItem.BetTime
        </td>
    </tr>
    <tr class="player-total-row">
        <td colspan="6">
            @RNGCasino.Player: @headerItem.UserName - @RNGCasino.Viewin @Model.Param.CurrencyName
        </td>
    </tr>
    <tr class="detail-header-row">
        <td colspan="6">@headerItem.ResultName
        </td>
    </tr>
    <tr>
        <td colspan="6">
            @if (!string.IsNullOrEmpty(headerItem.Result))
            {
                @Html.Raw(headerItem.Result.Replace("/Form", Url.Content("~/") + "Form"))
            }
        </td>
    </tr>
    <tr>
        <td>@RNGCasino.PlayerHistoryNo
        </td>
        <td class="align-left" colspan="5">@Model.Param.PlayerHistoryNo
        </td>
    </tr>
    <tr>
        <td>@RNGCasino.Mode
        </td>
        <td class="align-left" colspan="5">@headerItem.ModeResult
        </td>
    </tr>
    <tr>
        <td>@RNGCasino.AutoSpin
        </td>
        <td class="align-left" colspan="5">@headerItem.AutoSpinResult
        </td>
    </tr>
    <tr>
        <td>@RNGCasino.FreeSpin
        </td>
        <td class="align-left" colspan="5">@headerItem.FreeSpinResult
        </td>
    </tr>
    @if (hitItemList.Count() > 0)
    {
        <tr class="detail-header-row">
            <td>@RNGCasino.LineNo
            </td>
            <td>@RNGCasino.Symbol
            </td>
            <td>@RNGCasino.CoinSize
            </td>
            <td>@RNGCasino.Bet
            </td>
            <td>@RNGCasino.Odds
            </td>
            <td>@RNGCasino.Win
            </td>
        </tr>
        foreach (var item in hitItemList)
        {
        <tr>
            <td>
                @Html.Raw(item.LineNo.Replace("/img", Url.Content("~/") + "img"))
            </td>
            <td>
                @Html.Raw(item.Symbol.Replace("/img", Url.Content("~/") + "img"))
            </td>
            <td class="align-right">@item.CoinSize
            </td>
            <td class="align-right">@item.Bet
            </td>
            <td class="align-right">@item.Odds
            </td>
            <td class="align-right">@Html.Raw(FormaterCurrency.Format(decimal.Parse(item.Win)))
            </td>
        </tr>  
        }        
    }
    @if (hitBonusItemList.Count() > 0)
    {
        <tr class="detail-header-row">
            <td>@RNGCasino.Name
            </td>
            <td>@RNGCasino.Symbol
            </td>
            <td>@RNGCasino.Multiplier
            </td>
            <td colspan="3">@RNGCasino.Win/@RNGCasino.Loss
            </td>
        </tr>
        foreach (var item in hitBonusItemList)
        {
        <tr>
            <td>
                @item.BonusName
            </td>
            <td>
                @Html.Raw(item.Symbol.Replace("/img", Url.Content("~/") + "img"))
            </td>
            <td>@item.Multiplier
            </td>
            <td colspan="3" class="align-right">@Html.Raw(FormaterCurrency.Format(decimal.Parse(item.Win)))
            </td>
        </tr>  
        }
    }
    @if (totalItem != null)
    {        
        <tr>
            <td>@RNGCasino.Win
            </td>
            <td colspan="5" class="align-right">@FormaterCurrency.Format(totalItem.WinResultBaseCurrencyValue)
            </td>
        </tr>
    }
    <tr class="player-total-row">
        <td class="align-left">@RNGCasino.Total @RNGCasino.Bet
        </td>
        <td colspan="5" class="align-right">@FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.Bet))
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@RNGCasino.Total @RNGCasino.Win/@RNGCasino.Loss
        </td>
        <td colspan="5" class="align-right">@Html.Raw(FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.WinLoss)))        </td>
    </tr>
</table>
