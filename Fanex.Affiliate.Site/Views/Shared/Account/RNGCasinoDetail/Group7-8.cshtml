@{
    // Game type:  Winter Slot, Mamak Corner - full //
    Layout = null;
}
<link href="@Url.Content("/Athena006User/Content/betlist/rng-casino-hand-history.css")" rel="stylesheet" type="text/css" />
@model BetListResultsRNGCasinoDetailViewModel
@{
    var headerItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "BasicInfo").FirstOrDefault();
    var modeItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Mode").FirstOrDefault();
    var autoSpinItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "AutoSpin").FirstOrDefault();
    var freeSpinItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "FreeSpin").FirstOrDefault();
    var hitBetLineItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Result_HitBetLine").FirstOrDefault();
    var hitScatterItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Result_HitScatter").FirstOrDefault();
    var totalItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Add_TotalLineWinLoss").FirstOrDefault();
}
<table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
    <tr class="detail-header-row">
        <td class="game-type-text" colspan="5">@Model.Param.GameTypeName - @headerItem.BetTime
        </td>
    </tr>
    <tr class="player-total-row">
        <td colspan="5">
            @RNGCasino.Player: @headerItem.UserName - @RNGCasino.Viewin @Model.Param.CurrencyName
        </td>
    </tr>
    <tr class="detail-header-row">
        <td colspan="5">@headerItem.ResultName
        </td>
    </tr>
    <tr>
        <td colspan="5">
            @if (!string.IsNullOrEmpty(headerItem.Result))
            {
                @Html.Raw(headerItem.Result.Replace("/Form", Url.Content("~/") + "Form"))
            }
        </td>
    </tr>
    <tr>
        <td>@RNGCasino.PlayerHistoryNo
        </td>
        <td class="align-left" colspan="4">@Model.Param.PlayerHistoryNo
        </td>
    </tr>
    @if (modeItem != null || !string.IsNullOrEmpty(headerItem.ModeResult))
    {
        <tr>
            <td>@RNGCasino.Mode
            </td>
            <td class="align-left" colspan="4">
                @(!string.IsNullOrEmpty(headerItem.ModeResult)
                ? headerItem.ModeResult
                : modeItem.ModeResult)
            </td>
        </tr>
    }
    @if (autoSpinItem != null || !string.IsNullOrEmpty(headerItem.AutoSpinResult))
    {
        <tr>
            <td>@RNGCasino.AutoSpin
            </td>
            <td class="align-left" colspan="4">
                @(!string.IsNullOrEmpty(headerItem.AutoSpinResult)
                ? headerItem.AutoSpinResult
                : autoSpinItem.AutoSpinResult)
            </td>
        </tr>
    }
    @if (freeSpinItem != null || !string.IsNullOrEmpty(headerItem.FreeSpinResult))
    {
        <tr>
            <td>@RNGCasino.FreeSpin
            </td>
            <td class="align-left" colspan="4">
                @(!string.IsNullOrEmpty(headerItem.FreeSpinResult)
                ? headerItem.FreeSpinResult
                : freeSpinItem.FreeSpinResult)
            </td>
        </tr>    
    }
    @if (hitBetLineItem != null)
    {
        <tr class="detail-header-row">
            <td>@RNGCasino.LineNo
            </td>
            <td>@RNGCasino.Symbol
            </td>
            <td>@RNGCasino.CoinSize
            </td>
            <td>@RNGCasino.Odds
            </td>
            <td>@RNGCasino.Win/@RNGCasino.Loss
            </td>
        </tr>
        <tr>
            <td> 
                @if (!string.IsNullOrEmpty(hitBetLineItem.LineNo))
                {
                    @Html.Raw(hitBetLineItem.LineNo.Replace("/img", Url.Content("~/") + "img"))
                }
            </td>
            <td>
                @if (!string.IsNullOrEmpty(hitBetLineItem.Symbol))
                {
                    @Html.Raw(hitBetLineItem.Symbol.Replace("/img", Url.Content("~/") + "img"))
                }
            </td>
            <td>@FormaterCurrency(hitBetLineItem.CoinSizeBaseCurrencyValue)
            </td>
            <td>@hitBetLineItem.Odds
            </td>
            <td>@FormaterCurrency(hitBetLineItem.Win)
            </td>
        </tr>         
    }
    @if (hitScatterItem != null)
    {
        <tr class="detail-header-row">
            <td>@RNGCasino.TotalLineBet
            </td>
            <td>@RNGCasino.Symbol
            </td>
            <td>@RNGCasino.CoinSize
            </td>
            <td>@RNGCasino.Odds
            </td>
            <td>@RNGCasino.Win/@RNGCasino.Loss
            </td>
        </tr>
        <tr>
            <td>
                @hitScatterItem.TotalLineBet
            </td>
            <td>
                @if (!string.IsNullOrEmpty(hitScatterItem.Symbol))
                {
                    @Html.Raw(hitScatterItem.Symbol.Replace("/img", Url.Content("~/") + "img"))
                }
            </td>
            <td>@FormaterCurrency(hitScatterItem.CoinSizeBaseCurrencyValue)
            </td>
            <td>@hitScatterItem.Odds
            </td>
            <td>@FormaterCurrency(hitScatterItem.Win)
            </td>
        </tr>        
    }
    @if (totalItem != null)
    {
        <tr>
            <td>@RNGCasino.Win/@RNGCasino.Loss
            </td>
            <td colspan="4" class="align-right">@FormaterCurrency(totalItem.WinLossResultBaseCurrecyValue)
            </td>
        </tr>
    }
    <tr class="player-total-row">
        <td class="align-left">@RNGCasino.Total @RNGCasino.Bet
        </td>
        <td colspan="4" class="align-right">@FormaterCurrency(Model.CasinoDetailList.Sum(p => p.Bet))
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@RNGCasino.Total @RNGCasino.Win/@RNGCasino.Loss
        </td>
        <td colspan="4" class="align-right">@Html.Raw(FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.WinLoss)))
        </td>
    </tr>
</table>
