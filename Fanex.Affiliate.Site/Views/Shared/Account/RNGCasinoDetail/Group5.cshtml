@{
    Layout = null;
}
<link href="@Url.Content("/Content/betlist/rng-casino-hand-history.css")" rel="stylesheet" type="text/css" />
@model BetListResultsRNGCasinoDetailViewModel
@{
    var headerItem = Model.CasinoDetailHeaderList.FirstOrDefault();
}
<table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
    <tr class="detail-header-row">
        <td class="game-type-text" colspan="4">@Model.Param.GameTypeName - @headerItem.BetTime
        </td>
    </tr>
    <tr class="player-total-row">
        <td colspan="4">
            @RNGCasino.Player: @headerItem.UserName - @RNGCasino.Viewin @Model.Param.CurrencyName
        </td>
    </tr>
    <tr class="detail-header-row">
        <td colspan="4">@headerItem.ResultName
        </td>
    </tr>
    <tr>        
        <td colspan="4">
            @if (!string.IsNullOrEmpty(headerItem.Result))
            {
                @Html.Raw(headerItem.Result.Replace("/Form", Url.Content("~/") + "Form"))
            }
        </td>
    </tr>   
    <tr>
        <td>@RNGCasino.PlayerHistoryNo
        </td>
        <td colspan="3" class="align-left">@Model.Param.PlayerHistoryNo
        </td>
    </tr>    
    <tr class="detail-header-row">
        <td>@RNGCasino.Bet
        </td>
        <td>@RNGCasino.Bet @RNGCasino.Money
        </td>
        <td>@RNGCasino.Odds
        </td>
        <td>@RNGCasino.Win/@RNGCasino.Loss
        </td>
    </tr>
    @foreach (var detailItem in Model.CasinoDetailList)
    {
        <tr>
            <td>@detailItem.BetTypeName
            </td>
            <td>@FormaterCurrency.Format(detailItem.Bet)
            </td>
            <td>@FormaterCurrency.Format(detailItem.Odds)
            </td>
            <td class="align-right">@Html.Raw(FormaterCurrency.Format(detailItem.WinLoss))
            </td>        
        </tr>  
    }  
    <tr class="player-total-row">
        <td class="align-left">@RNGCasino.Total @RNGCasino.Bet
        </td>
        <td colspan="3" class="align-right">@FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.Bet))
        </td>
    </tr>
     <tr class="player-total-row">
        <td class="align-left">@RNGCasino.Total @RNGCasino.Win/@RNGCasino.Loss
        </td>
        <td colspan="3" class="align-right">@Html.Raw(FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.WinLoss)))
        </td>
    </tr>
</table>
