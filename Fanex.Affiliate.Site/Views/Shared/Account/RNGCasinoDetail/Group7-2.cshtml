@{
    // Game type:  4-Line Jacks or Better; 25-Line Jacks or Better; 50-Line Jacks or Better; //
    Layout = null; 
}
<link href="@Url.Content("/Athena006User/Content/betlist/rng-casino-hand-history.css")" rel="stylesheet" type="text/css" />
@model BetListResultsRNGCasinoDetailViewModel
@{
    var headerItem = Model.CasinoDetailHeaderList.FirstOrDefault();
}
<table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
    <tr class="detail-header-row">
        <td class="game-type-text" colspan="2">@Model.Param.GameTypeName - @headerItem.BetTime
        </td>
    </tr>
    <tr class="player-total-row">
        <td colspan="2">
            @RNGCasino.Player: @headerItem.UserName - @RNGCasino.Viewin @Model.Param.CurrencyName
        </td>
    </tr>
    <tr>
        <td>@RNGCasino.PlayerHistoryNo
        </td>
        <td class="align-left">@Model.Param.PlayerHistoryNo
        </td>
    </tr>
    @if (Model.CasinoDetailHeaderList.Count() == 1)
    {
        <tr>
            <td colspan="2">
                @Html.Raw(headerItem.Result.Replace("/Form", Url.Content("~/") + "Form"))
            </td>            
        </tr>
        <tr class="player-total-row">
            <td>@RNGCasino.RoundType
            </td>
            <td class="align-right">@headerItem.RoundTypeResult
            </td>
        </tr>
    }
    else
    {
        <tr>
            <td colspan="2">
                <table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
                    <tr class="detail-header-row">
                        <td>@RNGCasino.HandNo
                        </td>
                        <td>@RNGCasino.InitialHand
                        </td>
                        <td colspan="2">@RNGCasino.FinalHand
                        </td>
                        <td>@RNGCasino.Win
                        </td>
                    </tr>
                    @for (int i = 0; i < Model.CasinoDetailHeaderList.Count; i++)
                    {
                        var item = Model.CasinoDetailHeaderList[i];
                        <tr>
                            <td>@item.HandNoResult 
                            </td>
                            @if (i == 0)
                            {
                                <td rowspan="@Model.CasinoDetailHeaderList.Count">
                                    @Html.Raw(item.Result.Replace("/Form", Url.Content("~/") + "Form"))
                                </td>
                            }
                            <td>
                                @Html.Raw(item.FinalHandResult.Replace("/Form", Url.Content("~/") + "Form"))
                            </td>
                            <td>
                                @item.RankResult 
                            </td>
                            <td>
                                @FormaterCurrency.Format(item.WinResultBaseCurrencyValue)
                            </td>
                        </tr>
                    }
                </table>
            </td>
        </tr>
    }
    <tr class="player-total-row">
        <td class="align-left">@RNGCasino.Bet
        </td>
        <td class="align-right">@FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.Bet))
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@RNGCasino.Win/@RNGCasino.Loss
        </td>
        <td class="align-right">@Html.Raw(FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.WinLoss)))
        </td>
    </tr>
</table>
