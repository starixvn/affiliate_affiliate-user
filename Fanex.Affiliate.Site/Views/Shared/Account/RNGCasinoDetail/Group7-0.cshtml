@{
    // Game type:  Jacks or Better //
    Layout = null; 
}
<link href="@Url.Content("~/Content/betlist/rngcasino.handhistory.css")" rel="stylesheet" type="text/css" />
@model BetListResultsRNGCasinoDetailViewModel
@{
    var headerItem = Model.CasinoDetailHeaderList.FirstOrDefault();
}
<table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
    <tr class="detail-header-row">
        <td class="game-type-text" colspan="2">@Model.Param.GameTypeName - @headerItem.BetTime
        </td>
    </tr>
    <tr class="player-total-row">
        <td colspan="2">
            @RNGCasino.Player: @headerItem.UserName - @string.Format(RNGCasino.Viewin, Model.Param.CurrencyName)
        </td>
    </tr>
    <tr>
        <td colspan="2">
            @if (!string.IsNullOrEmpty(headerItem.Result))
            {
                @Html.Raw(headerItem.Result.Replace("/Form", Url.Content("~/") + "Form"))
            }
        </td>
    </tr>
    @if (Model.CasinoDetailHeaderList.Count > 1)
    {
        var secondItem = Model.CasinoDetailHeaderList[1];
    <tr>
        <td colspan="2">
            @if (!string.IsNullOrEmpty(secondItem.Result))
            {
                @Html.Raw(secondItem.Result.Replace("/Form", Url.Content("~/") + "Form"))
            }
        </td>
    </tr>
    }
    <tr class="player-total-row">
        <td>@RNGCasino.Bet
        </td>
        <td class="align-right">@FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.Bet))
        </td>
    </tr>
    <tr class="player-total-row">
        <td>@RNGCasino.Win/@RNGCasino.Loss
        </td>
        <td class="align-right">@Html.Raw(FormaterCurrency.Format(Model.CasinoDetailList.Sum(p => p.WinLoss)))
        </td>
    </tr>
</table>
