@{
    ViewBag.Title = "PaymentRequest";
    HtmlHelper.ClientValidationEnabled = false;
    Layout = @String.Format("../Layout/Layout{0}/_Layout.cshtml", AppSettings.Layout);
}

@model PaymentViewModel

@{
    var listPayment = Model.ListPayment;
    var pendingList = listPayment.Where(p => p.Status.ToLower() == "pending").ToList();
    var recentList = listPayment.Where(p => p.Status.ToLower() != "pending").ToList();
}

<div class="span12 box-insite">
    <div class="top">
        <div class="in-top">
            @Lang.PaymentRequest
        </div>
        <div class="in-right">
        </div>
    </div>
    <div class="content">
        <div class="block">
            <div class="title-block">
                @Lang.PaymentInfo
            </div>
            <div class="line-block">
            </div>
            <br />
            @using(Html.BeginForm("PaymentRequest", "Account", FormMethod.Post, new { id="RequestPaymentForm" }))
            {
                <div data-valmsg-summary="true" class="validation-summary-valid"><ul><li style="display:none"></li>
                </ul></div>       
                <div class="content-block">
                    <table class="table-padding">
                        <tr>
                            <td class="width250">@Lang.BalanceBroughtForward
                            </td>
                            <td class="text-right width120">
                                <div id="maxValue">@Html.Raw(FormaterCurrency.Format(Model.BalanceBroughtForward, SessionManager.CurrentSession.Currency, true, true))</div>
                                @Html.TextBoxFor(m => m.BalanceBroughtForward, Model.BalanceBroughtForward.ToString(), new { @id = "tbMaxAmount", @style = "display:none" })
                            </td>
                        </tr>
                        <tr>
                            <td>@Lang.MinimumWithdrawalAmount
                            </td>
                            <td class="text-right">
                                <div id="minValue">
                                    @Html.Raw(FormaterCurrency.Format(Model.MinimumWithdrawalAmount, SessionManager.CurrentSession.Currency, true, true))
                                </div>
                                @Html.TextBoxFor(m => m.MinimumWithdrawalAmount, Model.MinimumWithdrawalAmount.ToString(), new { @id = "tbMinAmount", @style = "display:none" })
                            </td>
                        </tr>
                        <tr>
                            <td>@Lang.InputRequestAmount
                            </td>
                            <td class="text-right">
                                @Html.TextBoxFor(m => m.Amount, string.Empty, new { @id = "tbAmount", @class = "input-amount", @Value = "", @style = "text-align:right", @maxlength = "25" })
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right" colspan="2">
                                <div style="height:10px;"> @Html.HiddenFor(m => m.PreferredPayment)</div>
                                <div>
                                    <input type="submit" value="@Lang.Requestpayout" class="button" id="btnSubmit" name="btnSubmit" />
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            }
            @if (pendingList.Any())
            {
                <div class="title-block">
                    @Lang.PendingRequest
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <table class="table odd-even list">
                        <thead>
                            <tr class="gradient-header">
                                <th style="width: 150px;">
                                    @Lang.RequestDate
                                </th>
                                <th style="width: 150px;">
                                    @string.Format("{0} ({1})", Lang.RequestAmount, FormaterCurrency.GetCurrencySymbol(SessionManager.CurrentSession.Currency))
                                </th>
                                <th style="width: 150px;">
                                    @Lang.Status
                                </th>
                                <th>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                var i = 0;

                foreach (var pending in pendingList)
                {
                    i++;
                                <tr class="@(i % 2 == 0 ? "even" : "odd")">
                                    <td class="text-center">
                                        @Common.ConvertDateTime(pending.TransDate, "/", true, false)
                                    </td>
                                    <td class="text-right">
                                        @Html.Raw(FormaterCurrency.Format(pending.Amount))
                                    </td>
                                    <td class="text-center">
                                        @Utility.Status(pending.Status)
                                    </td>
                                    <td class="text-center">
                                        @using (Html.BeginForm("CancelPaymentRequest", "Account", FormMethod.Post))
                                        {
                                            @Html.TextBoxFor(m => m.TransID, pending.TransID.ToString(), new { @id = "tbTransID", @Style = "display:none" })
                                            <input type="submit" class="button" value="@Lang.CancelRequest"/>
                                        }
                                    </td>
                                </tr>

                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div class="title-block">
                @Lang.RecentPayment
            </div>
            <div class="line-block">
            </div>
            <div class="content-block">
                <table class="table odd-even list">
                    <thead>
                        <tr class="gradient-header line-height">
                            <th style="width: 50px;">
                                @Lang.RefNo
                            </th>
                            <th style="width: 66px;">
                                @Lang.RequestDate
                            </th>
                            <th style="width: 95px;">
                                @string.Format("{0} ({1})", Lang.RequestAmount, FormaterCurrency.GetCurrencySymbol(SessionManager.CurrentSession.Currency))
                            </th>
                            <th style="width: 85px;">
                                @Lang.PaymentMethod
                            </th>
                            <th style="width: 80px;">
                                @Lang.CompletedDate
                            </th>
                            <th style="width: 40px;">
                                @Lang.Status
                            </th>
                            <th>
                                @Lang.Description
                            </th>
                        </tr>
                    </thead>
                    @if (recentList.Any())
                    {
                        <tbody>
                            @{
                        var i = 0;

                        foreach (var recent in recentList)
                        {
                            i++;
                                <tr class="@(i % 2 == 0 ? "even" : "odd")">
                                    <td class="text-center">
                                        @recent.TransID
                                    </td>
                                    <td class="text-center">
                                        @Common.ConvertDateTime(recent.TransDate, "/", true, false)
                                    </td>
                                    <td class="text-right">
                                        @Html.Raw(FormaterCurrency.Format(recent.Amount))
                                    </td>
                                    <td class="text-center">
                                        @Model.PreferredPayment.Replace("Wire", Lang.BankTransfer)
                                    </td>
                                    <td class="text-center">
                                        @Common.ConvertDateTime(recent.CompletedDate, "/", true, false)
                                    </td>
                                    <td class="text-center">
                                        @Utility.Status(recent.Status)
                                    </td>
                                    <td class="wordWrapTD">
                                        @Html.Raw(recent.AffDesc)
                                    </td>
                                </tr>
                        }
                            }
                        </tbody>
                    }
                    else
                    {
                        <tfoot>
                            <tr>
                                <td colspan="7" style="text-align:center">@Lang.NoInformation</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
</div>

@section scriptspage
{
    @Scripts.Render("~/js/paymentrequest")

    @{ 
        var result = (ResultViewModel)ViewBag.Result;
        if (result != null)
        {
            var msg = result.Message;
            if (!string.IsNullOrEmpty(msg))
            {
                if (result.Success == false)
                {
                    <script type="text/javascript">
                        AFFILIATE.showErrorMsg("@msg");
                    </script>
                }
                else
                {
                    <script type="text/javascript">
                        AFFILIATE.showSuccessMsg("@msg");
                    </script>
                }
            }
            else
            {
                <script type="text/javascript">
                    AFFILIATE.hideMessageRegion();
                </script>
            }
        }
    }
}