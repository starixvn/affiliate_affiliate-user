@{
    ViewBag.Title = Lang.ChangePassword
;
    Layout = @String.Format("../Layout/Layout{0}/_Layout.cshtml", AppSettings.Layout);
}
@section scriptspage
{
    <script src="~/Scripts/site/ChangePassword.js" type="text/javascript"></script>
    @if (ViewBag.Result != null)
    {
        var msg = ((ResultViewModel)ViewBag.Result).Message;
        if (((ResultViewModel)ViewBag.Result).Success == true && !msg.IsEmpty())
        {
        <script type="text/javascript">
            AFFILIATE.showSuccessMsg("@msg");
        </script>
        }
    }
}
@section css
{
    <link href="@Url.Content(string.Format("~/Content/themes/theme{0}/jquery.ui.tooltip.css", AppSettings.Layout))" rel="stylesheet" />
}
@using (Html.BeginForm())
{
    <div class="span12 box-insite">
        <div class="top">
            <div class="in-top">
                @Lang.ChangePassword
            </div>
            <div class="in-right">
            </div>
        </div>
        <div class="content">
            @Html.ValidationSummary()
            <div class="block">
                <div class="content-block">
                    @Lang.ChangePasswordInstruction
                </div>
            </div>
            <div class="block">
                <div class="content-block">
                    <table>
                        <tr>
                            <td class="tdwidth">
                                @Lang.OldPassword
                            </td>
                            <td>
                                <span class="txtRequire">*</span>&nbsp;&nbsp;
                            </td>
                            <td>
                                @Html.Password("OldPassword")
                            </td>
                            <td>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Lang.NewPassword
                            </td>
                            <td>
                                <span class="txtRequire">*</span>&nbsp;&nbsp;
                            </td>
                            <td>
                                @Html.Password("NewPassword", string.Empty, new { title = Lang.PasswordPattern, onkeyup = "return ChangePassword.validate(this);" })
                            </td>
                            <td>
                                <div id="NewPassword_validator" class="validate-fail" style="display:none">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Lang.ReenterNewPassword
                            </td>
                            <td>
                                <span class="txtRequire">*</span>&nbsp;&nbsp;
                            </td>
                            <td>
                                @Html.Password("ConfirmPassword", string.Empty, new { title = Lang.PasswordPattern, onkeyup = "return ChangePassword.validate(this);" })
                            </td>
                            <td>
                                <div id="ConfirmPassword_validator" class="validate-fail" style="display:none">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right" colspan="2">
                                <input type="submit" id="btnSubmit" class="button" value="@Lang.Submit" />
                            </td>
                            <td>
                                <input type="button" id="btnCancel" class="button" value="@Lang.Cancel" onclick="HandleCancelEvent()" />
                            </td>
                            <td>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
}