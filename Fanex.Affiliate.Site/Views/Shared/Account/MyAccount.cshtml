@{
    ViewBag.Title = Lang.AccountInformation;
    Layout = @String.Format("../Layout/Layout{0}/_Layout.cshtml", AppSettings.Layout);
}
@model UserViewModel
@using (Html.BeginForm())
{
    <div class="span12 box-insite">
        <div class="top">
            <div class="in-top">
                @Lang.AccountInformation</div>
            <div class="in-right">
            </div>
        </div>
        <div class="content">
            @Html.ValidationSummary()
            <div class="block">
                <div class="title-block">
                    @Lang.AccountInformation
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <table>
                        <tr>
                            <td width="150px">
                                @Lang.Username
                            </td>
                            <td width="16px">
                                &nbsp;
                            </td>
                            <td width="220px">
                                @SessionManager.CurrentSession.Username
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Lang.Password
                            </td>
                            <td>
                                &nbsp;
                            </td>
                            <td>
                                @Html.ActionLink(Lang.Change, "ChangePassword")
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="title-block">
                    @Lang.ContactInfo
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <table>
                        <tr>
                            <td width="150px">
                                @Html.LabelFor(m => m.Gender)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td width="220px" class="middle">
                                @Html.RadioButtonFor(model => model.Gender, "false") @Lang.Female
                                @Html.RadioButtonFor(model => model.Gender, "true") @Lang.Male
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Address)
                            </td>
                            <td>
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.Address)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.City)
                            </td>
                            <td>
                                <span class="txtRequire"></span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.City, new { @readonly = true })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.State)
                            </td>
                            <td>
                                <span class="txtRequire"></span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.State, new { @readonly = true })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Postal)
                            </td>
                            <td>
                                <span class="txtRequire"></span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.Postal, new { @readonly = true })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Country)
                            </td>
                            <td>
                                <span class="txtRequire"></span>
                            </td>
                            <td>
                                @Html.DropDownListFor(m => m.Country, Model.CountrySelectListItem, new { @readonly = true, disabled = true })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Email)
                            </td>
                            <td>
                                <span class="txtRequire"></span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.Email, new { @readonly = true })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Phone)
                            </td>
                            <td>
                                <span class="txtRequire"></span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.Phone, new { @readonly = true })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.MobilePhone)
                            </td>
                            <td>
                                <span class="txtRequire"></span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.MobilePhone, new { @readonly = true })
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="block">
                <div class="title-block">
                    @Lang.SiteInfo
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <table id="siteinfo">
                        <tr>
                            <td width="150px">
                                @Html.LabelFor(m => m.SiteURL)
                            </td>
                            <td width="16px">
                                <span class="txtRequire"></span>
                            </td>
                            <td width="220px">
                                @Html.TextBoxFor(m => m.SiteURL, new { @readonly = true, @class = "sites" })
                            </td>
                                &nbsp;
                            <td>
                               <input type="button" id="btnAddSite" class="button" value="@Lang.AddUrl" />
                            </td>
                        </tr>
                        @RazorHelper.GetMoreUrls(Model.MoreSiteURLs)
                    </table>
                </div>
            </div>
            <div class="block">
                <div class="title-block">
                    @Lang.Preference
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <table>
                        <tr>
                            <td width="150px">
                                @Html.LabelFor(m => m.Language)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td width="220px">
                                @Html.DropDownListFor(m => m.Language, Model.LanguageSelectListItem, new { id = "slLanguage" })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Currency)
                            </td>
                            <td>
                                <span class="txtRequire"></span>
                            </td>
                            <td>
                                @Html.DropDownListFor(m => m.Currency, Model.ExchangeSelectListItem, new { @readonly = true, disabled = true })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.EmailFormat)
                            </td>
                            <td>
                                <span class="txtRequire">*</span>
                            </td>
                            <td class="middle">
                                @Html.RadioButtonFor(model => model.EmailFormat, "true") @Lang.PlainText
                                @Html.RadioButtonFor(model => model.EmailFormat, "false") @Lang.HtmlFormat
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="block">
                <div class="title-block">
                    @Lang.PaymentInfo
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <table>
                        <tr>
                            <td colspan="5">
                                <strong>@Lang.PaymentMethod</strong>
                            </td>
                        </tr>
                        <tr>
                            <td width="150px">
                                <label>
                                    @Html.RadioButtonFor(m => m.PreferredPayment, "Player", new { @checked = "checked"})
                                    @Lang.PlayerAcc
                                </label>
                            </td>
                            <td width="16px">
                                &nbsp;
                            </td>
                            <td width="150px">
                                @Html.LabelFor(m => m.Player_Username)
                            </td>
                            <td width="16px">
                                <span class="txtRequire"></span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.Player_Username, new { @readonly = true })
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-center">
                                <input type="button" id="btnRegister" class="button" value="@Lang.Submit" />
                                <span>&nbsp;</span>
                                <input type="reset" class="button" value="@Lang.Cancel" onclick="javascript:window.location.href = '@Url.Content("~/Account/Overview")';" />
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!--to ignore check validation these fields-->
    <input id="FirstName" name="FirstName" type="hidden" value="FirstName" />
    <input id="LastName" name="LastName" type="hidden" value="LastName" />
    <input id="Question" name="Question" type="hidden" value="Question" />
    <input id="Answer" name="Answer" type="hidden" value="Answer" />
    <input id="Captcha" name="Captcha" type="hidden" value="Captcha" />
    <input id="VerifyEmail" name="VerifyEmail" type="hidden" value="@Model.Email" />
    <input type="hidden" id="moreSiteUrls" name="MoreSiteURLs"/>
    <div id="messageWebsite" site-info="@Lang.SiteURL" more-url="@Lang.WebsiteUrl" del="@Lang.Delete"></div>
    @Html.HiddenFor(m => m.Country)
    @Html.HiddenFor(m => m.Currency)
}
@section scriptspage
{
    <script src="~/Scripts/site/AccountInfo.js" type="text/javascript"></script>
    @if (ViewBag.Error != null)
    {
        var msg = ((ResultViewModel)ViewBag.Error).Message;
        <script type="text/javascript">
            AFFILIATE.showErrorMsg("@msg");
        </script>
    }
    @if (ViewBag.Result != null)
    {
        var msg = ((ResultViewModel)ViewBag.Result).Message;
        if (((ResultViewModel)ViewBag.Result).Success == true && !msg.IsEmpty())
        {
        <script type="text/javascript">
            AFFILIATE.showSuccessMsg("@msg");
        </script>
        }
    }
}