<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @Scripts.Render("~/js/jquery")
    @Styles.Render("~/css/jquery")
</head>
<body>
    <div class="container-um">
        <div class="row-fluid">`
            <div class="span12 header">
                <div class="row-fluid">
                    @Html.Partial("Header_Notify")
                </div>
            </div>
            <div class="span12 red-line">
            </div>

            <div class="span12 error">
                <div class="title">
                    @RenderSection("title", required: false)
                </div>
                <div class="notify-line">
                </div>
            </div>
            <div class="row">
                @RenderBody()
            </div>

        </div>
    </div>
</body>
</html>