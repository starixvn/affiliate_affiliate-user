@{
    ViewBag.Title = Lang.TermsConditions;
    Layout = @String.Format("../Layout/Layout{0}/_Layout.cshtml", AppSettings.Layout);
}

@{
    var classThai = AppSession.Language.Equals("th-TH") ? AppSession.Language : string.Empty;
    var classType = string.Format("class='span12 box-insite {0}'", classThai);
}

<div @Html.Raw(classType)>
    <div class="top">
        <div class="in-top">กติกาและเงื่อนไข</div>
        <div class="in-right">
        </div>
    </div>
    <div class="content">
        <div class="block">
            <div class="content-block">
                @string.Format("เพื่อที่จะเข้าร่วมโปรแกรมพันธมิตรกับ {0} คุณจะต้องสมัครโปรแกรมพันธมิตรโดยการกรอกใบสมัครผ่านแบบฟอร์มทางอินเตอร์เนต จากนั้นเมื่อการสมัครของคุณได้รับการอนุมัติคุณจะต้องดาวโหลดแบนเนอร์ของเราเพื่อที่จะนำไปวางไว้บนเวบไซค์ของคุณ อีเมลล์ของคุณ หรือในรูปแบบอื่น คุณได้เห็นด้วยทุกประการในกติกาและเงื่อนไขที่ระบุไว้ในเวบไซค์", AppSettings.SystemDisplayName)
                <p></p>
                @string.Format("ถ้าคุณตัดสินใจว่าจะไม่ยอมรับในกติกาและเงื่อนไขที่ทางเวบไซค์กำหนด กรุณาอย่าได้ดาวโหลดแบนเนอร์ หรือ ลิ้งค์ข้อความแล้วนำไปวางเพื่อทำการตลาดในเวบไซค์ของคุณ ในทุกข้อมูลที่เกี่ยวข้องกับ {0}", AppSettings.SystemDisplayName)
                <p></p>
                เราขอสงวนสิทธิ์ที่จะสิ้นสุดสัญญาฉบับนี้ ถ้าเราไตร่ตรองแล้วว่าเวบไซค์ของคุณไม่เหมาะสม  เวบไซค์ที่ไม่เหมาะสม อาจรวมถึงเวบไซค์ที่แสดงเกี่ยวกับเรื่องเพศ ที่มีลูกค้ากลุ่มเป้าหมายคือเด็กและเยาวชน  เวบไซค์ที่แสดงถึงความรุนแรง เวบไซค์ที่แบ่งแยกเชื้อชาติ เกี่ยวกับ เพศ ศาสนา หรือ สัญชาติ หรือคนพิการ หรือเวบไซค์ที่ส่งเสริมในเรื่องของกิจกรรมที่ผิดกฏหมาย หรือการละเมิดลิขสิทธิ์ เกี่ยวกับ ไอพี
                <p></p>
                @string.Format("นโยบายของ {0} เราจะไม่ยอมรับการสมัครออนไลน์ในการเป็นพันธมิตรถ้าคุณได้ทำการโฆษณาผ่านทางคอมพิวเตอร์ที่มีเครื่องไอพีตั้งอยู่หรือดำรงอยู่ในขอบเขตตามกฏหมายของประเทศอังกฤษโดยเด็ดขาด", AppSettings.SystemDisplayName)
                <p></p>
                @string.Format("รายละเอียดเกี่ยวกับสัญญาฉบับนี้เกี่ยวกับกติกาและเงื่อนไขการเป็นสมาชิกพันธมิตร {0} คุณ หมายถึง พันธมิตร อ้างอิงถึง บุคคลใดบุคคลหนึ่ง หรือ กลุ่มบุคคลที่ได้สมัครสมาชิกเข้ามาเป็นพันธมิตรกับเรา ภายใต้สัญญาฉบับนี้ ทั้งนี้จะรวมถึงลูกจ้าง พนักงานบริษัท ผู้อำนวยการ ผู้ถือหุ้น เจ้าของ ทั้งนี้ คำว่า ของท่านได้รวมถึงกลุ่มบุคคลเหล่านี้ด้วย", AppSettings.SystemDisplayName)
            </div>
        </div>
        <div class="block">
             <div class="title-block">
                1. ความรับผิดชอบที่มีต่อโปรแกรมพันธมิตร <a href="#" class="link-top"><span></span>@Lang.Top</a>
            </div>
            <div class="line-block"></div>
            <ol class="content-block">
                <li>@string.Format("เมื่อคุณได้เป็นพันธมิตรกับทางเราแล้วสิ่งที่คุณต้องทำคือการโปรโมตเวบไซค์ {0} โดยการนำแบนเนอร์ และ ลิงค์ข้อความของเราไปวางไว้บนเวบไซค์ของคุณ หรือ อีเมลล์ของคุณ หรือวิธีการประชาสัมพันธ์อื่นอื่น", AppSettings.SystemDisplayName)</li> 
                <li>@string.Format("คุณเห็นด้วยที่จะสมัครและให้ข้อมูลที่ถูกต้องและเชื่อถือได้ที่จะใช้ในการติดต่อกับเวบไซค์ {0}", AppSettings.SystemDisplayName)</li>
                <li>@string.Format("คุณจะเสนอเพียงเนื้อหาและหัวข้อที่ได้รับการอนุมัติเป็นลายลักษณ์อักษรจาก {0} ก่อนแล้วเท่านั้นบนไซต์ของคุณ เนื้อหาที่ทางเราไตร่ตรองแล้วเห็นว่าไม่เหมาะสมจะมีผลให้สัญญาหุ้นส่วนนี้สิ้นสุดลงทันที", AppSettings.SystemDisplayName)</li>
                <li>@string.Format("คุณจะต้องรับผิดชอบทั้งหมด ในเรื่องของการพัฒนาระบบ ของเวบไซค์ การบำรุงรักษาเวบไซค์และสื่งอื่นอื่นที่ปรากฏอยู่บนเวปไซค์ของคุณโดยค่าใช้จ่ายส่วนนี้คุณต้องเป็นคนออกเอง ตัวอย่างเช่น คุณจะต้องรับผิดชอบทั้งหมดเกี่ยวกับเรื่องอุปกรณ์ที่ใช้โพสต์ลงบนเวบไซค์ของคุณ และข้อกำหนดต่างต่างที่เกี่ยวกับการทำผิดกฏหมายหรือการละเมิดลิขสิทธิ์ที่อาจจะเกิดกับบุคคลอื่น เพราะว่าทางเราไม่สามารถเข้าไปควบคุมดูแลเวบไซค์ของคุณได้ เราจึงไม่สามารถรับผิดชอบในส่วนนี้ได้ มากไปกว่านั้นคุณจะต้องรับผิดชอบในส่วนของความเสียหายและค่าใช้จ่ายในเรื่องของค่าธรรมเนียมเกี่ยวกับกฏหมายที่เกี่ยวเนื่องถึงการพัฒนา การปฏิบัติงาน การบำรุงรักษา และ ข้อมูลบนเวบไซค์ของคุณ ข้อกำหนดเกี่ยวกับการชดเชยเหล่านี้ได้แบ่งแยกความรับผิดชอบไว้อย่างชัดเจนที่บังคับใช้ภายใต้กฏหมาย")</li>
            </ol>
        </div>
        <div class="block">
            <div class="title-block">
                2. การแนะนำเกี่ยวกับพันธมิตร <a href="#" class="link-top"><span></span>@Lang.Top</a>
            </div>
            <div class="line-block"></div>
            <ol class="content-block">
                <li>@string.Format("สื่อที่ใช้ในการโปรโมตเวบไซค์ที่ทางเวบไซค์ของเราได้จัดเตรียมให้กับลูกค้าพันธมิตรที่ได้รับสิทธิ์การเป็นพันธมิตรแล้ว จะถูกจัดเตรียมไว้ให้ท่านเรียบร้อยแล้ว อย่างไรก็ตามสื่ออื่นอื่นที่ไม่ได้รับการอนุญาติเป็นลายลักษณ์อักษรจากเวบไซค์ {0} ท่านจะไม่สามารถทำได้", AppSettings.SystemDisplayName)</li>
                <li>@string.Format("คุณไม่สามารถที่จะแก้ไขหรือสิทธิ์ที่ใช้ไอพี แบนเนอร์ หรือการใช้สิ่งเหล่านี้เพื่อวัตถุประสงค์อื่นโดยปราศจากความยินยอมเป็นลายลักษณ์อักษรจาก {0} ทุกข้อมูลที่เป็นลิขสิทธิ์ต่างต่างที่ได้รับการอนุมัติโดยเวปไซค์ {0} ไม่สามารถที่จะแก้ไขเปลี่ยนแปลงหรือลบออกส่วนหนึ่งส่วนใดได้", AppSettings.SystemDisplayName)</li>
                <li>@string.Format("การอนุญาติให้เข้าใช้งาน{0} โปรแกรมที่เกี่ยวข้อง ผู้ใช้สามารถดาวน์โหลดแถบโฆษณา, ข้อความ หรือโปรโมชั่นต่างๆไปใช้งานในหน้าของท่านได้ และสามารถใช้งานระหว่างอีเมลล์และการตลาดทางตรงโดยใช้ URL ของท่าน ซึ่งท่านจะได้รับสิทธิ์ในการโฆษณาผลิตภัณฑ์และบริการของเราเท่านั้น", AppSettings.SystemDisplayName)</li>
                <li>แบนเนอร์และ ลิ๊งค์ข้อความไม่สามารถที่จะนำไปวางและส่งในอีเมลล์แบบแสปม หรือ นำไปโพสต์ลงบนเวบไซค์ที่ไม่ได้รับการอนุญาติ หรือ ห้องสนทนาสดโดยใช้ ระบบคอมพิวเตอร์อัตโนมัติในการแสดงข้อมูล สิ่งเหล่านี้ถ้าถูกทำโดยสมาชิก จะไม่สามารถนำมานับรวม และ จะเป็นเหตุให้บัญชีพันธมิตรของท่านถูกยกเลิก</li>
                <li>@string.Format("เราจะยกเลิกสัญญานี้ทันที ถ้ามีการส่งขยะทางอีเมลล์ในนามของคุณเพื่อเป็นการทำลายชื่อเสียงของ เวบไซค์ {0} ซึ่งเป็นการทำการตลาดที่ผิดวิธี โดยใช้ข้อความหรือคำพูด", AppSettings.SystemDisplayName)</li>
                <li>@string.Format("คุณจะไม่สามารถอ้างสิทธิ์ การขอเป็นตัวแทน หรือขอการรับประกัน ในการติดต่อกับเวบไซค์ {0} หรือ ไม่มีอำนาจที่จะบังคับ {0} ให้รับผิดชอบในเรื่องใดก็ตาม", AppSettings.SystemDisplayName)</li>
                <li>@string.Format("ถ้าปราศจากการยินยอมเป็นลายลักษณ์อักษรคุณสามารถใช้แบนเนอร์ของเวบไซค์ {0} และลิ๊งค์ข้อความเพื่อใช้เครื่องมือในการโปรโมตเวบไซค์ {0} เท่านั้น ห้ามใช้เพื่อวัตถุประสงค์อื่น สัญลักษณ์ หรือ ลิ้งค์ข้อความเป็นลิขสิทธิ์ของเวบไซค์เราซึ่งมีไว้ให้สำหรับบุคคลที่ได้รับการอนุญาติจากเวบไซค์เราจึงจะสามารถใช้งานได้", AppSettings.SystemDisplayName)</li>
                <li>@string.Format("ถ้าเกิดมีกรณีที่การประชาสัมพันธ์ของคุณไม่ได้ถูกดำเนินการในรูปแบบที่เหมาะสมถูกต้องซึ่งอาจทำให้เกิดความเสียหายกับเวบไซค์ {0} ไม่ว่าจะเป็นกิจกรรมใดใดก็ตามที่ล่วงละเมิดผ่านทางเวบไซค์ของคุณ ทางบริษัทขอสงวนสิทธิ์ที่จะเรียกเก็บค่าคอมมิชชั่นที่ได้จ่ายให้แล้วคืนมา  การพิจารณาของทางเวบไซค์ถือว่าสามารถบังคับใช้ได้สูงสุด เราขอสงวนสิทธิ์ที่เรียกเก็บจำนวนค่าคอมมิชชั่นทั้งหมดที่ได้จ่ายไปในสัญญาฉบับนี้ ถ้ามีเหตุให้เราสามารถเชื่อได้ว่า กิจกรรมที่เกิดขึ้นเกิดจากความตั้งใจของท่านที่จะละเมิดกติกาพันธมิตรที่ทางเวบไซค์กำหนด แม้ว่าบางครั้งคุณอาจจะไม่ได้ตั้งใจ เราขอสงวนสิทธิ์ที่จะระงับการถอนเงินของคุณถ้ามีเหตุให้เชื่อว่ากิจกรรมที่ทำให้เกิดรายได้นั้นนั้นเกิดจากการกระทำของคุณเองหรือกลุ่มคณะบุคคลที่คุณรู้จักโดยตั้งใจ ทางเราขอสงวนสิทธิ์ที่จะระงับการจ่ายค่าคอมมิชชั่นชั่วคราว", AppSettings.SystemDisplayName)</li>
                <li>@string.Format("พันธมิตรไม่ได้รับอนุญาติให้เล่นในรายการกีฬาที่อยู่ในเวบไซค์ของ {0} ผ่านช่องทางการแนะนำของตัวพันธมิตรเองหรือใช้ชื่อบุคคลอื่นในการมีส่วนร่วมรับคอมมิชชั่นในโปรแกรมพันธมิตรนี้ ทั้งนี้รวมถึงบุคคลใดบุคคลหนึ่งหรือคณะบุคคลจากซึ่งได้รับคอมมิชชั่นจากโปรแกรมนี้ ถ้าหากมีการตรวจพบว่ากลุ่มบุคคลดังกล่าวได้ทำการตามที่กล่าวมาข้างต้น ทางเวบไซค์ {0} ขอสงวนสิทธิ์ในการยกเลิกที่จะจ่ายค่าคอมมิชชั่นหรือทุกรายการที่เล่นเข้ามา และสิทธิ์ในการเป็นพันธมิตรกับทางเวบไซค์ {0} ถือว่าสิ้นสุดลง และกลุ่มบุคคลดังกล่าวจะไม่ได้รับอนุญาติให้ทำการเล่นกับ {0} ในอนาคต", AppSettings.SystemDisplayName)</li>
                <li>@string.Format("คุณไม่ได้รับอนุญาตให้เป็นทั้งหุ้นส่วนและผู้แนะนำกับ {0} การละเมิดกฎนี้จะทำให้ {0} มีสิทธิเพียงฝ่ายเดียวที่จะระงับหุ้นส่วนและ/หรือผู้แนะนำอย่างใดอย่างหนึ่งหรือทั้งคู่ ผู้แนะนำหมายถึงผู้ที่มีความสัมพันธ์กับ {0} เป็นผู้ถูกเชิญชวนมาในโปรแกรม Refer-A-Friend ของเรา (ดังที่ได้กำหนดและมีในเว็บไซต์)", AppSettings.SystemDisplayName)
                    
                </li>
            </ol>
        </div>
        <div class="block">
             <div class="title-block">
                3. หัวข้อต่างต่างเกี่ยวกับพันธมิตร <a href="#" class="link-top"><span></span>@Lang.Top</a>
            </div>
            <div class="line-block"></div>
            <ol class="content-block">
                <li>@string.Format("คุณจะต้องรับผิดชอบสำหรับลูกค้าที่สมัครกับเวบไซค์ {0} เท่านั้น", AppSettings.SystemDisplayName)</li>
                <li>@string.Format("ทรัพย์สินในการใช้โปรโมตเวบไซค์ ที่พันธมิตรได้รับจากเวบไซค์ {0} เท่านั้นที่ได้รับอนุญาติ ซึ่งสืออื่นที่ไม่ได้รับจาก เวบไซค์ {0} จะไม่ได้รับอนุญาติให้ใช้ เป็นหน้าที่ของสมาชิกพันธมิตรที่จะตรวจสอบว่าลิ๊งค์ที่ใช้โปรโมตเวบไซค์สามารถใช้งานได้อย่างมีประสิทธิภาพ", AppSettings.SystemDisplayName)</li>
            </ol>
        </div>
        <div class="block">
             <div class="title-block">
                4. รายได้ ส่วนแบ่ง และ การจ่าย <a href="#" class="link-top"><span></span>@Lang.Top</a>
            </div>
            <div class="line-block"></div>
            <ol class="content-block">
