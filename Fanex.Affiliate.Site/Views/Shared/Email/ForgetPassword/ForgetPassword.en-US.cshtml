<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.RootUrl/Content/themes/@Model.ThemeID/images/emailBg.jpg">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="@Model.RootUrl/Content/themes/@Model.ThemeID/images/emailBanner.jpg">
                    </td>
                </tr>
                <tr>
                    <td height="3">
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.HeaderBgColor" height="30px">
                        &nbsp;&nbsp;<strong><font style="color: @Model.HeaderFontColor; font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif;
                            text-transform: uppercase;">Your login detail </font></strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.ContentBgColor">
                        <table width="100%" border="0">
                            <tr>
                                <td style="background-color:@Model.ContentBgColor !important; padding: 20px 15px;">
                                    <font style=" color: @Model.ContentFontColor; font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>Dear @Model.FirstName,</strong><br />
                                        <br />
                                        You have requested to recover your username or password. If you did not request
                                        it, please ignore this email.<br />
                                        Otherwise please visit the following link, then your new password will be emailed
                                        to you shortly:<br />
                                        <a href='@Model.RecoverPwdURL?uid=@Model.CustID&vid=@Model.ValidationCode'>@Model.RecoverPwdURL?uid=@Model.CustID&vid=@Model.ValidationCode</a><br />
                                        <br />
                                        Please note<br />
                                        * Your username is: @Model.Username
                                        <br />
                                        * Due to security reason, we must provide you a new password (you can change this
                                        at any time later).<br />
                                        * The above link will be expired and become useless in 24 hours.<br />
                                        <br />
                                        Have a great day!<br />
                                        <br />
                                        Best regards,<br />
                                        <br />
                                        @Model.AffiliateName Affiliates Team<br />
                                        <a href="mailto:@Model.MailContact">@Model.MailContact</a> 
                                   </font>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="right" bgcolor="@Model.CopyrightBgColor" height="25" style="padding-right: 15px">
                        <font style="font-size: 11px; color: @Model.CopyrightFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            © Copyright @Model.CopyrightYear <a href="@Model.CurrentMemberSiteDomain">@Model.MemberSiteDomainEmail</a>
                        </font>
                    </td>
                </tr>
                <tr>
                    <td bgcolor="@Model.FooterBgColor" align="center" height="40px">
                        <font style="font-size: 12px; color: @Model.FooterFontColor; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            This is a system auto generated email, please do not reply to this email directly.
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>