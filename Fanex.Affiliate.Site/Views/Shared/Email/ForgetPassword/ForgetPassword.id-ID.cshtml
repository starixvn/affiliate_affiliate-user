<table width="100%">
    <tr>
        <td valign="top" align="center" background="@Model.RootUrl/Content/themes/@Model.ThemeID/images/emailBg.jpg">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="@Model.RootUrl/Content/themes/@Model.ThemeID/images/emailBanner.jpg">
                    </td>
                </tr>
                <tr>
                    <td height="3">
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.HeaderBgColor" height="30">
                        &nbsp;&nbsp; <strong><font style="color: @Model.HeaderFontColor; font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif;
                            text-transform: uppercase;">Rincian login Anda</font></strong>
                    </td>
                </tr>
                <tr>
                    <td align="left" bgcolor="@Model.ContentBgColor">
                        <table width="100%" border="0">
                            <tr>
                                <td style="background-color:@Model.ContentBgColor !important; padding: 20px 15px;">
                                    <font style=" color: @Model.ContentFontColor; font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>Yang terhotmat @Model.FirstName,</strong><br />
                                        <br />
                                        Anda melakukan permintaan untuk mendapatkan kembali username atau password.
                                        Jika anda tidak melakukan permintaan ini, tolong hiraukan email ini.
                                        <br />
                                        Sebaliknya silakan klik link berikut ini, maka password baru akan segera diemailkan kepada anda :<br />
                                        <a href='@Model.RecoverPwdURL?uid=@Model.CustID&vid=@Model.ValidationCode'>@Model.RecoverPwdURL?uid=@Model.CustID&vid=@Model.ValidationCode</a><br />
                                        <br />
                                        Catatan :<br />
                                        * Username anda: @Model.Username
                                        <br />
                                        * Untuk alasan keamanan, kami akan memberikan password baru pada anda (anda dapat mengubahnya kapan saja nanti).<br />
                                        * Link yang diberikan diatas akan kadaluarsa dan menjadi tidak berguna setelah 24 jam.<br />
                                        <br />
                                        Have a great day!<br />
                                        <br />
                                        Best regards,<br />
                                        <br />
                                        The team at @Model.AffiliateName Affiliates<br />
                                        <a href="mailto:@Model.MailContact">@Model.MailContact</a> </font>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td align="right" bgcolor="@Model.CopyrightBgColor" height="25" style="padding-right: 15px">
                        <font style="color: @Model.CopyrightFontColor; font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            © Hak Cipta @Model.CopyrightYear <a href="@Model.CurrentMemberSiteDomain">@Model.MemberSiteDomainEmail</a>
                        </font>
                    </td>
                </tr>
                <tr>
                    <td align="center" bgcolor="@Model.FooterBgColor" height="40">
                        <font style="color: @Model.FooterFontColor;  font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            Ini adalah sistem yang dihasilkan otomatis email, harap jangan balas email ini secara langsung.
                        </font>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>