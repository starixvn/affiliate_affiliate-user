@using Fanex.Affiliate.Web.Mvc
@model SiteDomainInfo
@{
    ViewBag.Title = Lang.FAQs;
    Layout = String.Format("../Layout/Layout{0}/_Layout.cshtml", AppSettings.Layout);
    var linkApplicationForm = new object();
    if(SessionManager.CurrentSession == null)
    {
        linkApplicationForm = Html.ActionLink(Lang.ApplicationForm, "Index", "User");
    }
    else
    {
        linkApplicationForm = Lang.ApplicationForm; 
    }
}
@{
    var classThai = AppSession.Language.Equals("th-TH") ? AppSession.Language : string.Empty;
    var classType = string.Format("class='span12 box-insite {0}'", classThai);
}

<div @Html.Raw(classType)>
    <div class="top">
        <div class="in-top">@Lang.FAQs</div>
        <div class="in-right"></div>
    </div>
    <div class="content">
        <div class="block">
            <div class="title-block">
                Tổng quan <a href="#" class="link-top"><span></span>@Lang.Top</a>
            </div>
            <div class="line-block">
            </div>
            <div class="content-block">
                <b id="f1">@string.Format("Chương trình hội viên {0} là gì?", AppSettings.SystemDisplayName)</b>
                <br />
                @Html.Raw(string.Format("Chương trình hội viên {0} là một chương trình cộng tác nơi bạn có thể kiếm được hoa hồng dựa trên hoạt động cá cược của người chơi mà bạn giới thiệu tới {1} từ trang web của bạn thông qua hình thức giới thiệu trực tuyến hoặc ngoại tuyến.", AppSettings.SystemDisplayName, Html.Hyperlink(Model.MemberSiteDomain, Model.MemberSiteDomainWithoutProtocolnPort)))
                <p></p>
                <b id="f2">@string.Format("Tôi làm cách nào để đăng ký chương trình hội viên {0}?", AppSettings.SystemDisplayName) </b>
                <br />
                @Html.Raw(string.Format("Miễn phí khi tham gia chương trình hội viên {0}. Chỉ cần điền vào {1} của chúng tôi bạn sẽ được liên hệ để chấp nhận tham gia chương trình trong vòng 3 ngày làm việc. Nếu đơn của bạn được chấp nhận, bạn sẽ nhận được một email có chứa ID hội viên duy nhất cho phép bạn truy cập vào các biểu ngữ, liên kết văn bản và nội dung khác cũng như công cụ tiếp thị để thêm vào trang web của bạn.", AppSettings.SystemDisplayName, linkApplicationForm))
                <p></p>
                <b id="f3">Nếu tôi không có trang web, tôi có thể tham gia không?</b>
                <br />
                Vâng, bạn hoàn toàn có thể! Công ty sẽ cung cấp cho bạn một địa chỉ liên kết "URL" có thông tin về tài khoản của bạn. Khi đó bạn có thể: :
                <ul>
                    <li style="list-style-type: disc">Nhúng liên kết hình ảnh quảng cáo từ thư viện của chúng tôi tới các trang web công khai của bạn hoặc qua các diễn đàn để tìm kiếm người chơi của bạn về cho chúng tôi.</li>
                    <li style="list-style-type: disc">Gửi đường link này tới bất kỳ bạn bè, người chơi mà yêu thích thể thao hoặc yêu thích cá cược thể thao. Mỗi lần họ truy cập "URL" đó và đăng ký tài khoản, ngay lập tức họ sẽ trở thành người chơi bên dưới hệ thống của bạn.</li>
                </ul>
                @Html.Raw(string.Format("Để biết thêm chi tiết, xin vui lòng liên hệ với chúng tôi tại {0}.", string.Format("<a href=mailto:{0}>{0}</a>", AppSettings.MailContact)))
            </div>
        </div>
        <div class="block">
            <div class="title-block">
                Tiếp thị & Theo dõi<a href="#" class="link-top"><span></span>@Lang.Top</a>
            </div>
            <div class="line-block">
            </div>
            <div class="content-block">
                <b id="f4">Tôi lấy biểu ngữ và nội dung ở đâu?</b>
                <br />
                Bằng cách truy cập phần "Thư viện media" của chúng tôi, bạn sẽ có thể lựa chọn biểu ngữ mà bạn thích cũng như các liên kết văn bản cho trang web của mình.
                <p></p>
                <b id="f5">Hệ thống theo dõi người chơi của tôi như thế nào?</b>
                <br />
                @Html.Raw(string.Format("Chúng tôi sử dụng hệ thống theo dõi với công nghệ tiên tiến để đảm bảo bạn nhận được tín dụng cho 100% lưu lượng truy cập bạn gửi tới {0}. Các hội viên sử dụng URL duy nhất của mình được cung cấp trong khu vực \"Thư viện media\" để chỉ dẫn cho người chơi. Thông qua sử dụng cookie, khách truy cập nhấp vào URL duy nhất của một hội viên (biểu ngữ, liên kết văn bản, thông báo email, v.v...) được theo dõi và tín dụng tự động được cung cấp cho hội viên đó vì đã giới thiệu người chơi.", Html.Hyperlink(Model.MemberSiteDomain, Model.MemberSiteDomainWithoutProtocolnPort)))
                <p></p>
                <b>@Html.Raw(string.Format("Bạn sẽ theo dõi và cung cấp tín dụng cho tôi khi tôi chưa phải là thành viên và đã không đăng ký vào lần truy cập đầu tiên thông qua liên kết hội viên của tôi nhưng sau đó trở lại {0} và trở thành thành viên chứ?", Html.Hyperlink(Model.MemberSiteDomain, Model.MemberSiteDomainWithoutProtocolnPort)))</b>
                <br />
                @Html.Raw(string.Format("Đúng. Chúng tôi có thể theo dõi khách truy cập không đăng ký ngay nhưng sau đó trở lại {0} & đăng ký từ trang web hội viên của chúng tôi. Chúng tôi đặt giai đoạn bảo vệ là 90 ngày để bảo vệ hội viên giới thiệu đầu tiên. Công nghệ được sử dụng để quản lý việc này dựa trên các cookie.", Html.Hyperlink(Model.MemberSiteDomain, Model.MemberSiteDomainWithoutProtocolnPort)))
                <p>
                </p>
                <b>Cookie là gì?</b>
                <br />
                @Html.Raw(string.Format("Cookie là một cơ chế chung mà các kết nối về phía máy chủ có thể sử dụng để lưu trữ và truy xuất thông tin từ các kết nối về phía khách hàng. Cụ thể hơn, chúng là những tệp dữ liệu nhỏ được đặt trên máy tính của khách truy cập {0} từ các trang web được liên kết. Các tệp dữ liệu này chứa thông tin mà {0} sử dụng để theo dõi và ghi có cho các hội viên của mình một cách chính xác cho lưu lượng mà họ gửi tới. Việc theo dõi thông qua cookie có thể bao gồm, nhưng không giới hạn đối với các trang được truy cập cũng như ngày và giờ mà các trang cụ thể đó được truy cập.", Html.Hyperlink(Model.MemberSiteDomain, Model.MemberSiteDomainWithoutProtocolnPort)))
                <p>
                </p>
                <b>Bạn có tặng thưởng cho hội viên đầu tiên hay hội viên cuối cùng vì đã giới thiệu khách hàng không?</b>
                <br />
                Các cookie được ghi đè để làm lợi cho hội viên cuối cùng khi một khách hàng được giới thiệu.
                <p>
                </p>
                <b id="f6">Làm thế nào tôi có thể kiểm tra số tiền mình đã kiếm được?</b>
                <br />
                @string.Format("Bạn có thể đăng nhập vào tài khoản hội viên {0} để kiểm tra số liệu thống kê tiền hoa hồng theo thời gian thực hiện khả dụng với bạn trong vòng 24 giờ một ngày, 7 ngày một tuần và 365 ngày một năm.", AppSettings.SystemDisplayName)
                <p>
                </p>
                <b>Chính sách gửi thư rác của bạn là như thế nào?</b>
                <br />
                @string.Format("Chúng tôi không cho phép các hội viên của mình gửi thư rác dưới bất kỳ hình thức nào. Nếu chúng tôi phát hiện ra một hội viên gửi thư rác, chúng tôi sẽ cảnh cáo hội viên đó (nếu xét thấy đó là trường hợp nhẹ). Nếu việc gửi thư rác vẫn tiếp tục, hội viên đó sẽ bị cấm tham gia chương trình hội viên {0} của chúng tôi vĩnh viễn. ", AppSettings.SystemDisplayName)
            </div>
        </div>
        <div class="block">
            <div class="title-block">
                Rút tiền hoa hồng<a href="#" class="link-top"><span></span>@Lang.Top</a>
            </div>
            <div class="line-block">
            </div>
            <div class="content-block">
                <b id="f7">Tôi có thể sử dụng những phương thức nào rút tiền?</b>
                <br />
                @string.Format("Bạn có thể rút tiền trực tiếp thông qua tài khoản người chơi mà bạn tạo tại {0}.", AppSettings.SystemDisplayName)
                <p>
                </p>
                <b>Những loại tiền tệ nào được hỗ trợ khi rút tiền?</b>
                <br />
                @string.Format("Bạn có thể rút tiền thông qua các loại tiền tệ sau đây : {0}. Tỷ giá sẽ được áp dụng ngay ngày bạn rút tiền.", string.Join(", ", AppSettings.PlayerCurrencies.OrderBy(c => c.CurrencyCode).Select(x => x.CurrencyCode).ToArray()))
                <p>
                </p>
                <b id="f8">Mức hoa hồng thấp nhất có thể rút là bao nhiêu?</b>
                <br />
                @string.Format("Số tiền yêu cầu rút tối thiểu là {1}{0}.", AppSettings.DefaultCurrencySymbol, AppSettings.MinimumWithdrawalAmount)
                <p>
                </p>
                <b>Số dư bằng âm sẽ chuyển tiếp không?</b>
                <br />
                Vâng ,chúng tôi sẽ chuyển tiếp số dư bằng âm đã tổng kết. Ví dụ đến cuối tháng tổng kết số dư trong tài khoản của bạn là số âm, số tiền này sẽ chuyển tiếp đến tháng sau, cho đến khi tiền hoa hồng bạn kiếm được là số dương có thể làm cho số âm đó thành 0.
                <p>
                </p>
                <b>Tôi có thể bao lâu rút tiền một lần?</b>
                <br />
                Hội viên chỉ có thể thực hiện rút tiền một lần vào mỗi tháng. Nhưng nếu được sự chấp thuận của giám đốc bộ phận kết nối, bạn cũng có thể trong vòng một tháng rút hai lần tiền hoa hồng. Hiện tại phục vụ rút tiền của chúng tôi hoàn toàn miễn phí, nhưng chúng tôi sẽ không chi trả bất kỳ phí thủ tục hoặc phí phát sinh nào khác.
            </div>
            @if (SessionManager.CurrentSession == null)
            {
                <br />
                <div class="joinUsButton">
                    <a class="signup" href="~/User/Index"><span>@string.Format("THAM GIA CHƯƠNG TRÌNH HỘI VIÊN {0}", AppSettings.SystemDisplayName).ToUpper()</span></a>
                </div>
            }
        </div>
    </div>
</div>