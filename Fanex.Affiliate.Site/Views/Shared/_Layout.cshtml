<!DOCTYPE html>
<html lang="en-us">
@using StackExchange.Profiling;
<head>
    <link type="image/x-icon" href="@Url.Content(string.Format("~/Content/themes/theme{0}/images/favicon.jpg", AppSettings.Theme))" rel="shortcut icon" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/css/jquery")
    @Styles.Render("~/css/core")
    @RenderSection("css", required: false)
</head>

<body>
    @RenderBody()
    @Html.Partial("_AffResources")
    @MiniProfiler.RenderIncludes()

    @Scripts.Render("~/js/jquery")
    @Scripts.Render("~/js/core")
    @RenderSection("scripts", required: false)
    <script type="text/ecmascript">
        $.unblockUI();       

         AFFILIATE.getAbsoluteUrl = function (relativeUrl) {
             return '@Url.Content("~/")' + relativeUrl;
         };
    </script>
    @if (string.IsNullOrWhiteSpace(AppSettings.PiwikSiteId) == false && AppSettings.Environment.Equals("Production", StringComparison.OrdinalIgnoreCase))
    {
        <script type="text/ecmascript">
            var piwikSiteId = '@AppSettings.PiwikSiteId';        
            
            var _paq = _paq || [];
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);
            (function () {
                var u = "https://pw.detecas.com/";
                _paq.push(['setTrackerUrl', u + 'piwik.php']);
                _paq.push(['setSiteId', piwikSiteId]);            
                var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
                g.type = 'text/javascript'; g.async = true; g.defer = true; g.src = u + 'piwik.js'; s.parentNode.insertBefore(g, s);
            })();           
        </script>     
        <noscript><p><img src="https://pw.detecas.com/piwik.php?idsite=@(AppSettings.PiwikSiteId)'  style="border:0;" alt="" /></p></noscript>
    }   
</body>
</html>