<!DOCTYPE html>
<html lang="en-us">
@using StackExchange.Profiling;
<head>
    <link type="image/x-icon" href="@Url.Content(string.Format("~/Content/themes/theme{0}/images/favicon.jpg", AppSettings.Theme))" rel="shortcut icon" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/css/jquery")
    @Styles.Render("~/css/core")
    @RenderSection("css", required: false)
</head>

<body>
    @RenderBody()
    @Html.Partial("_AffResources")
    @MiniProfiler.RenderIncludes()

    @Scripts.Render("~/js/jquery")
    @Scripts.Render("~/js/core")
    <script type="text/ecmascript">
        $.unblockUI();

         AFFILIATE.getAbsoluteUrl = function (relativeUrl) {
             return '@Url.Content("~/")' + relativeUrl;
         };
    </script>
    @RenderSection("scripts", required: false)    
</body>
    @if (Fanex.Affiliate.Configurations.AppSettings.Environment == "Production")
    {
        Html.RenderPartial("~/Views/Piwik/" + Fanex.Affiliate.Configurations.AppSettings.AffiliateName.ToLower() + ".cshtml");
    }
</html>