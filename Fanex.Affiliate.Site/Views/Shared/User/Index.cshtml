@{
    ViewBag.Title = string.Format(Lang.AffiliateTitle, AppSettings.AffiliateName);
    Layout = @String.Format("../Layout/Layout{0}/_Layout.cshtml", AppSettings.Layout);
}
@model UserViewModel
@using (Html.BeginForm())
{
    <div class="span12 box-insite">
        <div class="top">
            <div class="in-top">
                @Lang.RegisForm</div>
            <div class="in-right">
            </div>
        </div>
        <div class="content">
            @Html.ValidationSummary()
            <div class="block">
                <div class="content-block">
                    @string.Format(Lang.CompleteForm, AppSettings.AffiliateName)
                    <br />
                    @Html.Raw(HttpUtility.HtmlDecode(Lang.RequireInfo))
                </div>
            </div>
            <div class="block">
                <div class="title-block">
                    @Lang.ContactInfo
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <table>
                        <tr>
                            <td class="tdwidth">
                                @Html.LabelFor(m => m.FirstName)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.FirstName)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.LastName)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.LastName)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Gender)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td class="middle">
                                @Html.RadioButtonFor(model => model.Gender, "false") @Lang.Female
                                @Html.RadioButtonFor(model => model.Gender, "true") @Lang.Male
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Email)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.Email)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.VerifyEmail)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.VerifyEmail)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Phone)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.Phone)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.MobilePhone)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.MobilePhone)
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="block">
                <div class="title-block">
                    @Lang.MailingInfor
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <table>
                        <tr>
                            <td class="tdwidth">
                                @Html.LabelFor(m => m.Address)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.Address)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.City)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.City)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.State)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.State)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Postal)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.Postal)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Country)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.DropDownListFor(m => m.Country, Model.CountrySelectListItem, new { id = "country" })
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="block">
                <div class="title-block">
                    @Lang.SiteInfo
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <table id="siteinfo">
                        <tr>
                            <td class="tdwidth">
                                @Html.LabelFor(m => m.SiteURL)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.SiteURL, new { @class = "sites" })
                            </td>
                            <td>
                                <input type="button" id="btnAddSite" class="button" value="@Lang.AddUrl" />
                            </td>
                        </tr>
                        @RazorHelper.GetMoreUrls(Model.MoreSiteURLs)
                    </table>
                </div>
            </div>
            <div class="block">
                <div class="title-block">
                    @Lang.Preference
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <table>
                        <tr>
                            <td class="tdwidth">
                                @Html.LabelFor(m => m.Language)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.DropDownListFor(m => m.Language, Model.LanguageSelectListItem, new { id = "slLanguage" })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Currency)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.DropDownListFor(m => m.Currency, Model.ExchangeSelectListItem, new { id = "currency" })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.EmailFormat)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td class="middle">
                                @Html.RadioButtonFor(model => model.EmailFormat, "true") @Lang.PlainText
                                @Html.RadioButtonFor(model => model.EmailFormat, "false") @Lang.HtmlFormat
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Question)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.DropDownListFor(m => m.Question, Model.SecurityQuestionSelectListItem, new { id = "question" })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Answer)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.Answer)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.LabelFor(m => m.Captcha)
                            </td>
                            <td width="16px">
                                <span class="txtRequire">*</span>
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.Captcha)
                                <img src="@Url.Action("CaptchaImage", "User")" id="captcha-signup" class="mouse-pointer" alt="Captcha" />
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="block">
                <div class="title-block">
                    @Lang.PaymentInfo
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <table>
                        <tr>
                            <td colspan="3">
                                <strong>@Lang.PaymentMethod</strong>
                            </td>
                        </tr>
                        <tr>
                            <td class="tdwidth middle">
                                <label>
                                    @Html.RadioButtonFor(m => m.PreferredPayment, "Player", new { @checked = "checked"})
                                    @Lang.PlayerAcc
                                </label>
                            </td>
                            <td width="16px">
                            </td>
                            <td>
                                @Html.LabelFor(m => m.Player_Username)
                            </td>
                            <td width="50px">
                            </td>
                            <td width="16px">
                                @if(!AppSettings.IsKiosk)
                                {
                                    <span class="txtRequire">*</span>
                                }
                            </td>
                            <td>
                                @Html.TextBoxFor(m => m.Player_Username)
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" class="text-center">
                                <input type="submit" id="btnRegister" class="button" value="@Lang.Submit" />
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <input type="hidden" id="moreSiteUrls" name="MoreSiteURLs" />
    <div id="messageWebsite" site-info="@Lang.SiteURL" more-url="@Lang.WebsiteUrl" del="@Lang.Delete">
    </div>
}
@section scriptspage
{
    <script src="~/Scripts/site/SignUp.js" type="text/javascript"></script>
    @if (ViewBag.Error != null)
    {
        var msg = ((ResultViewModel)ViewBag.Error).Message;
        <script type="text/javascript">
            AFFILIATE.showErrorMsg("@msg");
            SIGNUP.reloadCaptcha();
        </script>
    }
}