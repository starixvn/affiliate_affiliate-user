@{
    ViewBag.Title = "ForgetPasswordResults";
    Layout = @String.Format("../Layout/Layout{0}/_Layout.cshtml", AppSettings.Layout);
}

<div class="span12 box-insite">
    <div class="top">
        <div class="in-top">
            @Lang.ForgetPassword
        </div>
        <div class="in-right">
        </div>
    </div>
    <div id="instructionContent" class="content">
        @if (ViewBag.Result == true)
        {
            <div class="in-top">
                @Html.Raw(string.Format(Lang.ForgetPasswordSuccess, Html.ActionLink(Lang.ContactUs, string.Empty, "ContactUs")))
            </div>
        }
        else
        {
            <div class="in-top">
                @Html.Raw(Lang.Msg106)
            </div>
        }    
    </div>
</div>
