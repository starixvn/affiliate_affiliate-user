@{
    ViewBag.Title = Lang.SignUp;
    Layout = @String.Format("../Layout/Layout{0}/_Layout.cshtml", AppSettings.Layout);
}


<div class="span12 box-insite">
    <div class="top">
        <div class="in-top">@Lang.ApplicationUnde</div>
        <div class="in-right">
        </div>
    </div>
    <div class="content">
        <form name="frmRegister" class="frmRegister" action="">
        <div class="block">
            <div class="content-block">
                @Html.Raw(string.Format(Lang.RegisSuccess, AppSettings.SystemDisplayName))
                <br /><br />
                <input name="btnReset" id="btnReset" value="@Lang.Back" class="button" type="button" />
            </div>
        </div>
        </form>
    </div>
</div>