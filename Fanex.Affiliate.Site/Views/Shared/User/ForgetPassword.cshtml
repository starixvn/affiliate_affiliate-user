@{
    ViewBag.Title = "ForgetPassword";
    Layout = @String.Format("../Layout/Layout{0}/_Layout.cshtml", AppSettings.Layout);
}
@model Fanex.Affiliate.Criteria.ForgetPasswordCriteria

@using (Html.BeginForm())
{
    <div class="span12 box-insite">
        <div class="top">
            <div class="in-top">
                @Lang.ForgetPassword
            </div>
            <div class="in-right">
            </div>
        </div>
        <div id="instructionContent" class="content">
            @Html.ValidationSummary()
            <div id="errorForgetPass" class="forgetpassword-errors hidden">
            </div>
            <div class="in-top">
                @Html.Raw(string.Format(Lang.ForgetPasswordInstruction, string.Format("<a href='{0}'>{1}</a>", Url.Content("~/ContactUs"), Lang.ContactUs)) )
            </div>
            <br />
            <div class="in-top">
                <table>
                    <tr>
                        <td class="label" style="width: 135px; font-weight: bold;">@Lang.YourEmail
                        </td>
                        <td><span class="txtRequire">*</span>&nbsp;&nbsp;&nbsp;@Html.TextBoxFor(m => m.Email, new { autocomplete = "off" })
                        </td>
                    </tr>
                    <tr>
                        <td class="label" style="width: 100px; font-weight: bold;">@Lang.Validation
                        </td>
                        <td>
                            <div class="action"><span class="txtRequire">*</span>&nbsp;&nbsp;
                                @Html.TextBoxFor(m => m.ValidCode, new { autocomplete = "off", @class = "inputValidate", @placeholder = Lang.Validation, @Style = "width:50px", })
                                <img src="@Url.Action("CaptchaImageForgetPwd", "User")" id="img-captchaForgetPassword" class="mouse-pointer" alt="Captcha" />
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            &nbsp;
                        </td>
                        <td>
                            <input type="submit" value="@Lang.Submit" class="button" id="btnSubmit" name="btnSubmit">
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div id="successContent" class="content hidden">
            @Html.Raw(string.Format(Lang.ForgetPasswordSuccess, Html.ActionLink(Lang.ContactUs, string.Empty, "ContactUs")))
        </div>
    </div>
}
@section scriptspage
{
    @Scripts.Render("~/js/forgetpwd")

    @if (ViewBag.Error != null)
    {
        var msg = Html.Raw(((ResultViewModel)ViewBag.Error).Message);
        <script type="text/javascript">
            AFFILIATE.showErrorMsg('@msg');
        </script>
    }
}