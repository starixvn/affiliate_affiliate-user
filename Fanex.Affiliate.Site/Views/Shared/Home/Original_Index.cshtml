@{
    ViewBag.Title = Lang.ProgramDetails;
    Layout = @String.Format("../Layout/Layout{0}/_Layout.cshtml", AppSettings.Layout);
}
@model DefaultProductCommissionViewModel
@{
    string productList = string.Empty;

    if (Model.ProductList.Count > 0)
    {
        productList = string.Join(", ", Model.ProductList.Select(t => t.ProductName));
    }

    if (Fanex.Affiliate.Configurations.AppSettings.Environment == "Production")
    {
        Html.RenderPartial("~/Views/Piwik/" + Fanex.Affiliate.Configurations.AppSettings.AffiliateName.ToLower() + ".cshtml");
    }
}

@{
    var classThai = AppSession.Language.Equals("th-TH") ? AppSession.Language : string.Empty;
    var classType = string.Format("class='span12 box-insite {0}'", classThai);
}

<div @Html.Raw(classType)>
    <div class="top">
        <div class="in-top">@Lang.ProgramDetails</div>
        <div class="in-right">
        </div>
    </div>
    <div class="content">
        <div class="block">
            <div class="content-block">
                <p>@Html.Raw(string.Format(Terms.PD_AsAffiliate, AppSettings.AffiliateName))</p>
                <p>@Terms.PD_HowMuchYouEarn</p>
            </div>
        </div>
        @if (!AppSettings.IsKiosk)
        {
            <div class="block">
                <div class="title-block">
                    @Terms.PD_AffiliateSupport <a href="#" class="link-top"><span></span>@Lang.Top</a>
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <p>@Terms.PD_WeOfferCurrency: @AppSettings.AffiliateBaseCurrencyList.</p>
                    @{
                var baseCurrencyList = AppSettings.AffiliateBaseCurrencyList.Split(',');
                var multiplyByCurrencyList = AppSettings.AffiliateCurrencyListMultipliedBy.Split(',');
                var commonCurrencyList = baseCurrencyList.Intersect(multiplyByCurrencyList);

                if (commonCurrencyList.Any())
                {
                            <p>@string.Format(Terms.PD_DropSomeLastZeroDigits, AppSettings.AffiliateCurrencyListMultipliedBy, FormaterCurrency.GetCurrencySymbol(commonCurrencyList.First()), AppSettings.MulitpliedBy)</p>
                }
                    }
                </div>
            </div>
            <div class="block">
                <div class="title-block">
                    @Terms.PD_AffiliateEarnings <a href="#" class="link-top"><span></span>@Lang.Top</a>
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <p>
                        <b>@Terms.PD_RevenueShareModel</b>
                        <br />
                        @Terms.PD_RevenueShareModelSplitIntoComponents: @productList.
                    </p>
                    <p>@Terms.PD_TotalRevenue:</p>
                    <table class="table odd-even list">
                        <thead>
                            <tr>
                                <th style="width: 85px; text-align: center;">
                                    @Lang.Product
                                </th>
                                <th style="width: 10px; text-align: center;">
                                    @Lang.Tier
                                </th>
                                <th style="text-align: center;">
                                    @string.Format(Lang.ComNetWin, AppSettings.DefaultCurrencySymbol)
                                </th>
                                <th style="width: 150px; text-align: center;">
                                    @Lang.QualifyingMembers
                                </th>
                                <th style="width: 50px; text-align: center;">
                                    @Lang.Commission
                                </th>
                            </tr>
                        </thead>
                        @if (Model.ProductList.Any())
                        {
                            <tbody>
                                @{
                            const int MAXQM = 1000000000;
                            const long MAXAMOUNT = 100000000000000;
                            var oldProductId = 0;
                            var index = 0;
                            foreach (var product in Model.ProductList)
                            {
                                var listGroupSetting = Model.GroupSetting.Where(p => (AppSettings.IsShowZeroCommission == "1") ? p.ProductId == product.ProductId : p.ProductId == product.ProductId && p.Commission != 0).ToList();
                                int totalShownTier = listGroupSetting.Count;
                                var noTier = 0;
                                if (totalShownTier > 0)
                                {
                                    index++;
                                    foreach (var groupSetting in listGroupSetting)
                                    {

                                            <tr class="@(index % 2 == 0 ? "even" : "odd")">
                                                @if (oldProductId != groupSetting.ProductId)
                                                {
                                                    <td rowspan="@totalShownTier" class="bold text-center">
                                                        @product.ProductName
                                                    </td>
                                                }
                                                <td class="text-center">
                                                    @(++noTier)
                                                </td>
                                                <td class="text-right">
                                                    @string.Format("{0}{1}", FormaterCurrency.Format(groupSetting.MinAmount),
                                                    groupSetting.MaxAmount == MAXAMOUNT ? "+" : " - " + FormaterCurrency.Format(Convert.ToInt64(groupSetting.MaxAmount) + 0.99))
                                                </td>
                                                <td class="text-right">
                                                    @string.Format("{0}{1}", groupSetting.MinQM,
                                                    groupSetting.MaxQM == MAXQM ? "+" : " - " + groupSetting.MaxQM.ToString())
                                                </td>
                                                <td class="text-right">
                                                    @string.Format("{0}%", Convert.ToDouble(groupSetting.Commission) * 100)
                                                </td>
                                            </tr>
                                                oldProductId = product.ProductId;
                                    }
                                }
                            }
                                }
                            </tbody>
                        }
                        else
                        {
                            <tfoot>
                                <tr>
                                    <td colspan="5" align="center">@Lang.NoInformation
                                    </td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                    <p>
                        @Terms.PD_PurposeOfTable:
                        <br />
                        @Terms.PD_CompanyNetWinFormula
                        @if(AppSettings.CompanyNegativeNetWin > 0)
                        {
                            <br />
                            <span>@string.Format(Terms.PD_CompanyNegativeNetWin, AppSettings.CompanyNegativeNetWin)</span>
                        }
                    </p>
                    <span></span>
                </div>
            </div>
            <div class="block">
                <div class="title-block">@Terms.PD_NegativeBalance<a href="#" class="link-top"><span></span>@Lang.Top</a>
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <p>@Html.Raw(string.Format(Terms.PD_AnyNegativeBalance, AppSettings.DefaultCurrencySymbol))</p>
                    <p>@Terms.PD_NoteThatSample @AppSettings.DefaultCurrency</p>
                </div>
            </div>
            <div class="block">
                <div class="title-block">
                    @Terms.PD_GettingPaid <a href="#" class="link-top"><span></span>@Lang.Top</a>
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <p>@string.Format(Terms.PD_YouRequestPayout, string.Join(", ", AppSettings.PlayerCurrencies.OrderBy(c => c.CurrencyCode).Select(x => x.CurrencyCode).ToArray()))</p>
                    <p>@string.Format(Terms.PD_WeOfferWithdrawalMethod, AppSettings.AffiliateName)</p>
                </div>
            </div>
        }
    </div>
</div>
