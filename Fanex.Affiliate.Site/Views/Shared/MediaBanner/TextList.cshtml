@{
    ViewBag.Title = Lang.TextBox;
    Layout = @String.Format("../Layout/Layout{0}/_Layout.cshtml", AppSettings.Layout);
}

@model MarketingViewModel

@{
    var domainPrefix = Model.DomainSelected.Split('.').First().Trim();
    var bannerDomain = "http://" + Model.DomainSelected.Replace(domainPrefix, "banner");
    var scriptUrl = AppSettings.IsProduction ? bannerDomain + "/MarketingTools/GetScript/" : AppSettings.BannerScriptUrl.OriginalString;
}

@using (Html.BeginForm("TextBox", "Account"))
{
    <div class="span12 box-insite">
        <div class="top">
            <div class="in-top">
                @Lang.TextBox
            </div>
            <div class="in-right">
            </div>
        </div>
        <div class="content">
            <div class="block">
                <div class="title-block">
                    @Lang.Search
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <table class="table-striped table-padding">
                        <tr>
                            <td style="width:100px;">
                                @Lang.Category
                            </td>
                            <td>
                                @RazorHelper.DropDownListCategory(Model.CategoryList.ToList(), Model.CategorySelected, new Dictionary<string, object> { { "id", "slCategory" }, { "name", "BannerCategory" } })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Lang.Language
                            </td>
                            <td>
                                @RazorHelper.DropDownListLanguage(Model.BaseLanguages.ToList(), Model.LanguageSelected, new Dictionary<string, object> { { "id", "slLanguage" }, { "name", "Language" } })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Lang.Currency
                            </td>
                            <td>
                                @RazorHelper.DropDownListCurrency(Model.CurrencyList.ToList(), Model.CurrencySelected, new Dictionary<string, object> { { "id", "slCurrency" }, { "name", "Currency" } })
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="height: 35px;">
                                <input type="button" class="button" value="@Lang.Search" id="btnSearch" name="btnSearch" />
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="title-block">
                    @Lang.TextLink
                </div>
                <div class="line-block">
                </div>
                <div class="content-block">
                    <table class="table-striped table-padding">
                        <tr>
                            <td style="white-space: nowrap; width:100px;">
                                @Lang.AvailableDomains
                            </td>
                            <td>
                                @RazorHelper.DropDownListDomain(Model.DomainList.ToList(), Model.DomainSelected, new Dictionary<string, object> { { "id", "slDomain" }, { "name", "Domain" } })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Lang.LinkTo
                            </td>
                            <td>
                                @RazorHelper.DropDownListLink(Model.LinkList.ToList(), Model.LinkSelected, new Dictionary<string, object> { { "id", "slLinkTo" }, { "name", "LinkTo" } })
                                &nbsp;&nbsp;<input type="button" class="button" value="@Lang.GenerateLink" id="btnGenerateLink" name="btnGenerateLink" />
                            </td>
                        </tr>
                        @foreach (var lang in Model.BaseLanguages.ToList())
                        {
                            <tr>
                                <td>
                                    @lang.LanguageName
                                </td>
                                <td>
                                    @RazorHelper.GenerateLink(AppSettings.LinkFormat, Model.CustomerID, Model.DomainSelected, Model.LinkSelected, lang.LanguageId)
                                </td>
                            </tr>
                        }
                        <tr>
                            <td>
                                @Lang.LinkDefault
                            </td>
                            <td>
                                @RazorHelper.GenerateLink(AppSettings.LinkFormat, Model.CustomerID, Model.DomainSelected, Model.LinkSelected, Model.PreferLanguage)
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="title-block">
                    @Lang.Banner
                </div>
                <div class="line-block">
                </div>
                @if (Model.BannerList.Any())
                {
                    var bannerList = Model.BannerList.ToPagedList(Model.PageIndex, Model.PageSize, Model.TotalPages * Model.PageSize);
                    <div class="content-block">
                        <div class="pagesize pull-right">
                            <span class="items-per-page">
                                @Lang.PageSize
                                @Html.DropDownList("items-per-page", new List<SelectListItem> {
                                    new SelectListItem { Value = "10", Text = "10", Selected = "10" == Model.PageSize.ToString() },
                                    new SelectListItem { Value = "20", Text = "20", Selected = "20" == Model.PageSize.ToString() },
                                    new SelectListItem { Value = "50", Text = "50", Selected = "50" == Model.PageSize.ToString() },
                                    new SelectListItem { Value = "100", Text = "100", Selected = "100" == Model.PageSize.ToString()},
                                    new SelectListItem { Value = "200", Text = "200", Selected = "200" == Model.PageSize.ToString()}
                                }, new { id = string.Empty, @class = "items-per-page", @data_controller = "/MediaBanner/TextList" })
                            </span>
                        </div>
                        <div class="paging-info clear">
                            @Html.Pager(bannerList.PageSize, bannerList.PageNumber, bannerList.TotalItemCount)
                        </div>
                        <table class="aff-table table-padding" style="width:100%">
                            <tbody id="result">
                                @foreach (var banner in Model.BannerList)
                                {
                                    var signUpLink = RazorHelper.GenerateLink(
                                        AppSettings.LinkFormat,
                                        Model.CustomerID,
                                        Model.DomainSelected,
                                        Model.LinkSelected,
                                        banner.LanguageCode).ToHtmlString();

                                    var srcVal = scriptUrl + banner.BannerId.ToString();
                                    <tr>
                                        <td class='cont12oe' colspan='3'>
                                            @HttpUtility.HtmlDecode(banner.Content.Replace("\r\n", "<br />"))
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class='cont12oe' colspan='3'>
                                            <input type='text' style='width: 610px' onclick='this.focus();this.select();'
                                                   value="&lt;a class='banner_@(AppSettings.SystemName + banner.BannerId.ToString())' onclick='window.open(&quot;@signUpLink?ref=&quot; + location.href,&quot;_blank&quot;); return false;' href='@signUpLink' target='_blank' id=&quot;bannerContainer&quot;&gt;&lt;/a&gt;&lt;script src=&quot;@srcVal?signuplink=@signUpLink&quot; type=&quot;text/javascript&quot;&gt;&lt;/script&gt;" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="paging-info clear">
                            @Html.Pager(bannerList.PageSize, bannerList.PageNumber, bannerList.TotalItemCount)
                        </div>
                    </div>
                }
                else
                {
                    <table class="aff-table table-padding" style="width:100%">
                        <tbody>
                            <tr>
                                <td class="text-center">
                                    @Lang.NoInformation
                                </td>
                            </tr>
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}

@section scriptspage
{
    @Scripts.Render("~/js/mediagallery")
}