<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/css/jquery")
    @Styles.Render("~/css/core")
</head>
<body class="popup">
    <div class="container-fluid">
        <div class="row-fluid">
            <div class="span12 contents">
                <div class="row-fluid">
                    <div class="span9 leftColumn">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

@Scripts.Render("~/js/jquery")
@Scripts.Render("~/js/core")
<script type="text/ecmascript">
    $.unblockUI();

    var Lang = {
        Close: "@Lang.Close"
    };

    AFFILIATE.getAbsoluteUrl = function (relativeUrl) {
        return '@Url.Content("~/")' + relativeUrl;
    };

</script>
@RenderSection("scripts", required: false)