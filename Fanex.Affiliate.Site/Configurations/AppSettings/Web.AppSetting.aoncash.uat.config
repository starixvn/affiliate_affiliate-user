<?xml version="1.0"?>
<appSettings>
  <add key="BannerDomain" value="http://aff3.starific.net/Banner/Home/Banner/" />
  <!--System Settings-->
  <add key="AffiliateName" value="aoncash" />
  <add key="Environment" value="UAT" />
  <add key="Layout" value="2" />
  <add key="Theme" value="9" />
  <add key="PageSize" value="10" />
  <add key="ServerID" value="400009" />
  <add key="InputAffType" value="1" />
  <add key="IsShowZeroCommission" value="1" />
  <add key="IsShowDetailDailyEarnings" value="1" />
  <add key="DefaultLanguage" value="en-US" />
  <add key="DefaultTarget" value="Sportsbook" />
  <add key="TimeHotMessage" value="60" />
  <add key="DefaultCurrency" value="USD" />
