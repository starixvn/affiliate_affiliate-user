  <add key="EmailContentBgColor" value="#fff" />
  <add key="EmailContentFontColor" value="#000" />
  <add key="EmailCopyrightBgColor" value="#d7d7d7" />
  <add key="EmailCopyrightFontColor" value="#333" />
  <add key="EmailFooterBgColor" value="#a30003" />
  <add key="EmailFooterFontColor" value="#eba6a6" />
  <!--End mail Template-->

  <!--Config Mail-->
