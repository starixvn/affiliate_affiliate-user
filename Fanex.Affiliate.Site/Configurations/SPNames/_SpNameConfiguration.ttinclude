<#@ template debug="true" hostSpecific="true" #>
<#
    SiteInfo.Host = Host;
#>
<#@ import namespace="System" #>
<#
	
    var licenseeNames = new string[] {
		"spondemo",
		"9bet", 
		"allbetclub",
		"aoncash",
		"athena000",
		"be7",
		"be7th",
		"goobet",
		"itcbet",
		"m8bola",
		"macaubet",
		"aiabet",
		"q8bola",
		"unobet"
	};

	var dbNames = new string[] {
		"DBAFFSPONDEMO.Affiliate_Spondemo.bodbDownlineNet", 
		"DBAFF9BET.Affiliate_9Bet.bodbDownlineNet", 
		"DBAFFALLBETCLUB.Affiliate_Allbetclub.bodbDownlineNet",
		"DBAFFAONCASH.Affiliate_Aoncash.bodbDownlineNet",
		"DBAFFATHENA000.Affiliate_Athena000.bodbDownlineNet",
		"DBAFFBE7.Affiliate_BE7.bodbDownlineNet",
		"DBAFFBE7TH.Affiliate_BE7TH.bodbDownlineNet",
		"DBAFFGOOBET.Affiliate_Goobet.bodbDownlineNet",
		"DBAFFITCBET.Affiliate_itcbet.bodbDownlineNet",
		"DBAFFM8BOLA.Affiliate_m8bola.bodbDownlineNet",
		"DBAFFMACAUBET.Affiliate_MacauBet.bodbDownlineNet",
		"DBAFFAIABET.Affiliate_AIAbet.bodbDownlineNet",
		"DBAFFQ8BOLA.Affiliate_Q8BOLA.bodbDownlineNet",
		"DBAFFUNOBET.Affiliate_unobet.bodbDownlineNet"
	};

	var environments = new string[] { "uat", "production" };

	var sites = new List<SiteInfo>();
	
	sites.Add(new SiteInfo(){
				Environment = "DEV",
				LicenseeName = "athena000",
				DbName = "DBAFFATHENA000.Affiliate_Athena000.bodbDownlineNet"
			});
	sites.Add(new SiteInfo(){
				Environment = "sit",
				LicenseeName = "athena000",
				DbName = "DBAFFATHENA000.Affiliate_Athena000.bodbDownlineNet"
			});
	sites.Add(new SiteInfo(){
				Environment = "local",
				LicenseeName = "spondemo",
				DbName = "DBAFFSPONDEMO.Affiliate_Spondemo.bodbDownlineNet"
			});
	sites.Add(new SiteInfo(){
				Environment = "sit",
				LicenseeName = "spondemo",
				DbName = "DBAFFSPONDEMO.Affiliate_Spondemo.bodbDownlineNet"
			});

	foreach(var environment in environments)
	{
		for(var i = 0; i < licenseeNames.Length; i++)
		{
			var licenseeName = licenseeNames[i];
			var dbName = dbNames[i];

			sites.Add(new SiteInfo(){
				Environment = environment,
				LicenseeName = licenseeName,
				DbName = dbName
			});
		}
	}
#>
<#+
	class SiteInfo
    {		
		private const string SpNameTemplate = "SpName=\"{0}\"";

		public static ITextTemplatingEngineHost Host { get; set; }

		public string LicenseeName { get; set; }

		public string DbName { get; set; }

        public string Environment { get; set; }
		
		public string GenerateSpName(string allSpNames, IEnumerable<SpNameConfig> spConfigs)
		{
			var generateSpNameText = allSpNames;
			generateSpNameText = generateSpNameText.Replace(
								"DbName=\"\"", "DbName=\"" + this.DbName + "\"");

			spConfigs = spConfigs.Where (
					x => 
					(string.IsNullOrEmpty(x.LicenseeName) || x.LicenseeName.Equals(this.LicenseeName, StringComparison.OrdinalIgnoreCase)) &&
					x.Environment.Equals(this.Environment, StringComparison.OrdinalIgnoreCase))
					.ToList();
				
			foreach (var item in spConfigs)
			{
				generateSpNameText = Regex.Replace(
					generateSpNameText, 
					string.Format(SpNameTemplate, item.SpName), 
					string.Format(SpNameTemplate, item.SpName + item.Suffix), 
					RegexOptions.IgnoreCase); 
			}
			
			return generateSpNameText;
		}	
    }

	class SpNameConfig
	{	
		public string LicenseeName {get; set;}

		public string Environment {get;set;}

		public string SpName {get;set;}

		public string Suffix {get;set;}
	}

	static class Helper 
	{	
		public static string GetAllSpNames()
        {
            return System.IO.File.ReadAllText(@"Fanex.Affiliate.Site\Configurations\SpNames\_SpNameOriginal.xml");
        }

		public static System.Collections.Generic.List<SpNameConfig> GetListOfSpConfig()
		{
			string path = SiteInfo.Host.ResolveAssemblyReference("$(SolutionDir)");
			Directory.SetCurrentDirectory(path);				
			var document = System.Xml.Linq.XDocument.Load(@"Fanex.Affiliate.Site\Configurations\SpNames\_SpNameConfig.xml");
			var elements = document.Root.Elements("item");
			var listOfConfig = new System.Collections.Generic.List<SpNameConfig>();
				
			foreach (var element in elements)
			{
				var enviroments = element.Attribute("Environment").Value.Trim().Split(',');
				foreach(var enviroment in enviroments)
				{
					listOfConfig.Add(new SpNameConfig
					{
						LicenseeName = element.Attribute("LicenseeName").Value.Trim(),
						Environment = enviroment.Trim(),
						SpName = element.Attribute("SpName").Value.Trim(),
						Suffix = element.Attribute("Suffix").Value.Trim(),
					});
				}
			}

			return listOfConfig;			
		}
	}
#>